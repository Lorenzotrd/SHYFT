---
// Gabarit des pages refaites : polices Instrument auto-hébergées, tokens, cadre arrondi,
// bandeau de consentement et mesure d'audience existants, données structurées (l'agence sur toutes les pages,
// puis celles de la page), nettoyées de tout champ vide.
import '../styles/tokens.css';
import { BRAND, SITE_URL, GA_ID, GTM_ID } from '../lib/site';
import { langOf, ui, LANGS, type Paths } from '../lib/i18n';
import { services, single } from '../lib/content';
import { organisation, clean } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Adresse de la page dans chaque langue ('/' et '/en' pour l'accueil) : canonique et hreflang. */
  paths: Paths;
  noindex?: boolean;
  jsonLd?: unknown[];
  /** Retire les paramètres de l'adresse avant GTM (page merci Cal.com : nom et email possibles). */
  cleanUrl?: boolean;
}

const { title, description, paths, noindex = false, jsonLd, cleanUrl = false } = Astro.props;
const lang = langOf(Astro.url);
const t = ui[lang];
const canonical = `${SITE_URL}${paths[lang] ?? paths.fr}`;
// Événement Cal.com (« shyftgrowth/30min ») pour booking.js, depuis le réglage calUrl.
const calLink = new URL((await single('site', lang)).calUrl).pathname.replace(/^\//, '');
// Google Consent Mode v2 : tout refusé par défaut, avant GTM ; choix déjà accepté (bandeau, analytics.js) rétabli
// aussitôt. Puis le chargeur officiel de GTM.
const all = (v: string) => ['ad_storage', 'ad_user_data', 'ad_personalization', 'analytics_storage', 'functionality_storage', 'personalization_storage'].map((k) => `${k}:'${v}'`).join(',');
const gtmBoot = GTM_ID ? [
  cleanUrl ? "if(location.search)history.replaceState(null,'',location.pathname+location.hash);" : '',
  'window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}window.gtag=gtag;',
  `gtag('consent','default',{${all('denied')},security_storage:'granted',wait_for_update:500});`,
  "gtag('set','ads_data_redaction',true);",
  `try{if(localStorage.getItem('shyft:consent')==='granted')gtag('consent','update',{${all('granted')}})}catch(e){}`,
  `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(GTM_ID)});`,
].join('\n') : '';
// hreflang seulement si la page existe dans les deux langues ; x-default vers le français.
const alternates = paths.en ? LANGS.map((l) => ({ hreflang: ui[l].htmlLang, href: `${SITE_URL}${paths[l]}` })) : [];
// « < » échappé : aucun contenu ne peut refermer la balise script.
const structured = JSON.stringify(clean([organisation(lang, await services(lang)), ...((jsonLd ?? []) as never[])])).replace(/</g, '\\u003c');
const range = {
  latin: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD',
  ext: 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF',
};
const face = (family: string, file: string, unicode: string, style = 'normal', weight = '400 700') =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(/assets/fonts/${file}) format('woff2');unicode-range:${unicode}}`;
const fontCss =
  face('Instrument Sans', 'InstrumentSans-latin.woff2', range.latin) +
  face('Instrument Sans', 'InstrumentSans-latin-ext.woff2', range.ext) +
  face('Instrument Serif', 'InstrumentSerif-italic-latin.woff2', range.latin, 'italic', '400') +
  face('Instrument Serif', 'InstrumentSerif-italic-latin-ext.woff2', range.ext, 'italic', '400');
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{gtmBoot && <script is:inline set:html={gtmBoot}></script>}
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, follow">}
<link rel="canonical" href={canonical}>
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href}>)}
{!noindex && alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${paths.fr}`}>}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={BRAND}>
<meta property="og:locale" content={t.ogLocale}>
{alternates.length > 0 && LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale}>)}
<meta property="og:url" content={canonical}>
<meta property="og:image" content={`${SITE_URL}/assets/og.png?v=2`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={t.ogAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#f3f3f3">
<link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
<link rel="icon" href="/assets/favicon.svg?v=2" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png?v=2">
<link rel="preload" href="/assets/fonts/InstrumentSans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/InstrumentSerif-italic-latin.woff2" as="font" type="font/woff2" crossorigin>
<style set:html={fontCss}></style>
</head>
<body>
{GTM_ID && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
<a class="skip-link" href="#main">{t.skip}</a>
<div class="frame"><slot /></div>
<script type="application/ld+json" is:inline set:html={structured}></script>
<script>
  // Provenance de la visite (campagne, gclid, site d'origine, première visite), gardée pour la demande d'audit.
  const KEEP = ['utm_source', 'utm_medium', 'utm_campaign', 'gclid'];
  try {
    const params = new URLSearchParams(location.search);
    KEEP.forEach((k) => { const v = params.get(k); if (v) sessionStorage.setItem(k, v.slice(0, 200)); });
    if (document.referrer && !document.referrer.includes(location.host) && !sessionStorage.getItem('referrer')) sessionStorage.setItem('referrer', document.referrer.slice(0, 300));
    if (!localStorage.getItem('shyft:first')) localStorage.setItem('shyft:first', new Date().toISOString());
  } catch { /* stockage bloqué (navigation privée) : la demande part sans provenance */ }
</script>
{GTM_ID && <script is:inline src="/assets/analytics.js" data-ga={GA_ID} defer></script>}
<script is:inline src="/assets/booking.js" data-cal={calLink} defer></script>
</body>
</html>
