---
// Gabarit des pages refaites : polices Instrument auto-hébergées, tokens, cadre arrondi,
// bandeau de consentement et mesure d'audience existants, données structurées.
import '../styles/tokens.css';
import { BRAND, SITE_URL, GA_ID, ADS_CONVERSION, META_PIXEL_ID } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Chemin sans barre oblique initiale : '' pour l'accueil. */
  path: string;
  noindex?: boolean;
  jsonLd?: unknown[];
}

const { title, description, path, noindex = false, jsonLd } = Astro.props;
const canonical = `${SITE_URL}/${path}`;
const range = {
  latin: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD',
  ext: 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF',
};
const face = (family: string, file: string, unicode: string, style = 'normal', weight = '400 700') =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(/assets/fonts/${file}) format('woff2');unicode-range:${unicode}}`;
const fontCss =
  face('Instrument Sans', 'InstrumentSans-latin.woff2', range.latin) +
  face('Instrument Sans', 'InstrumentSans-latin-ext.woff2', range.ext) +
  face('Instrument Serif', 'InstrumentSerif-italic-latin.woff2', range.latin, 'italic', '400') +
  face('Instrument Serif', 'InstrumentSerif-italic-latin-ext.woff2', range.ext, 'italic', '400');
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, follow">}
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={BRAND}>
<meta property="og:locale" content="fr_FR">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={`${SITE_URL}/assets/og.png`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#e9e9e9">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/InstrumentSans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/InstrumentSerif-italic-latin.woff2" as="font" type="font/woff2" crossorigin>
<style set:html={fontCss}></style>
</head>
<body>
<a class="skip-link" href="#main">Aller au contenu</a>
<div class="page"><div class="frame"><slot /></div></div>
{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>}
<script>
  // Provenance de la visite (campagne, gclid, site d'origine, première visite), gardée pour la demande d'audit.
  const KEEP = ['utm_source', 'utm_medium', 'utm_campaign', 'gclid'];
  try {
    const params = new URLSearchParams(location.search);
    KEEP.forEach((k) => { const v = params.get(k); if (v) sessionStorage.setItem(k, v.slice(0, 200)); });
    if (document.referrer && !document.referrer.includes(location.host) && !sessionStorage.getItem('referrer')) sessionStorage.setItem('referrer', document.referrer.slice(0, 300));
    if (!localStorage.getItem('shyft:first')) localStorage.setItem('shyft:first', new Date().toISOString());
  } catch { /* stockage bloqué (navigation privée) : la demande part sans provenance */ }
</script>
{GA_ID && <script is:inline src="/assets/analytics.js" data-ga={GA_ID} data-ads={ADS_CONVERSION || undefined} data-meta={META_PIXEL_ID || undefined} defer></script>}
</body>
</html>
