---
// Résultats : une grande carte (budget géré) et quatre cartes chiffrées, chacune liée à son service.
import Bouton from '../shyft/Bouton.astro';
import Icon from '../shyft/Icon.astro';
import { rich } from '../../lib/site';
import { langOf, route } from '../../lib/i18n';
import type { CollectionEntry } from 'astro:content';
interface Props { resultats: CollectionEntry<'accueil'>['data']['resultats'] }
const { resultats: r } = Astro.props;
const to = route[langOf(Astro.url)];
---
<section class="section results" id="resultats" aria-labelledby="results-titre">
  <div class="section-head">
    <h2 id="results-titre" class="h2" set:html={rich(r.titre)}></h2>
    <p>{r.texte}</p>
  </div>
  <div class="grid">
    <div class="big on-dark">
      <span class="k">{r.grande.surtitre}</span>
      <span class="fig">{r.grande.chiffre}</span>
      <span class="cap">{r.grande.legende}</span>
      <div class="lines">{r.grande.lignes.map((l) => <div class="line"><span>{l.label}</span><b>{l.valeur}</b></div>)}</div>
      <Bouton href={to.audit} size="sm" emplacement="accueil-resultats" class="big-cta">{r.grande.cta}</Bouton>
    </div>
    {r.cartes.map((c) => (
      <div class="stat">
        <div class="head"><span class="k">{c.surtitre}</span><a href={to.service(c.service)}>{c.lien}<Icon name="arrow" size={12} stroke={2.6} /></a></div>
        <span class="fig">{c.chiffre}</span>
        <span class="cap">{c.legende}</span>
        <p>{c.texte}</p>
      </div>
    ))}
  </div>
  <p class="note">{r.note}</p>
</section>
<style>
  .results{padding-left:clamp(14px, 2.8vw, 40px);padding-right:clamp(14px, 2.8vw, 40px);display:flex;flex-direction:column;gap:44px}
  .section-head,.note{padding:0 clamp(6px, 3.5vw, 50px)}
  .grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;grid-template-rows:auto auto;gap:16px}
  .k{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .big{grid-row:span 2;display:flex;flex-direction:column;padding:40px;border-radius:var(--r-card);background:var(--dark);color:var(--on-dark)}
  .big .k{color:var(--on-dark-muted)}
  .big .fig{margin-top:56px;font-size:clamp(72px, 8.9vw, 128px);line-height:.95;font-weight:600;letter-spacing:-.06em;color:var(--accent);white-space:nowrap}
  .big .cap{margin-top:18px;font-size:24px;line-height:1.25;font-weight:600;letter-spacing:-.03em}
  .lines{margin:36px 0;display:flex;flex-direction:column;gap:14px}
  .line{display:flex;justify-content:space-between;gap:16px;padding-top:14px;border-top:1px solid var(--dark-line);font-size:15px}
  .line span{color:var(--on-dark-muted)}
  .big :global(.big-cta){margin-top:auto;align-self:flex-start}
  .stat{display:flex;flex-direction:column;padding:30px 32px;border-radius:var(--r-card);background:var(--card)}
  .head{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .head a{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--muted)}
  .head a:hover{color:var(--ink)}
  .stat .fig{margin-top:30px;font-size:clamp(56px, 5.3vw, 76px);line-height:1;font-weight:600;letter-spacing:-.06em;white-space:nowrap}
  .stat .cap{margin-top:14px;min-height:48px;font-size:18px;line-height:1.3;font-weight:600;letter-spacing:-.02em}
  .stat p{margin-top:16px;padding-top:14px;border-top:1px solid var(--line-2);font-size:14px;line-height:1.55;color:var(--muted)}
  .note{font-size:13px;color:var(--label)}
  @media (max-width:1024px){
    .grid{grid-template-columns:1fr 1fr}
    .big{grid-column:1 / -1;grid-row:auto}
  }
  @media (max-width:640px){
    .results{gap:18px}
    .grid{gap:10px}
    .big{padding:24px;border-radius:22px}
    .big .fig{margin-top:14px;font-size:72px}
    .big .cap{margin-top:10px;font-size:16px}
    .lines{margin:18px 0 20px;gap:10px}
    .line{font-size:13px;padding-top:10px}
    .line:nth-child(n+3),.big :global(.big-cta),.note{display:none}
    .lines{margin-bottom:0}
    .stat{padding:18px;border-radius:18px}
    .head{display:none}
    .stat .fig{margin-top:0;font-size:38px}
    .stat .cap{margin-top:6px;min-height:0;font-size:13px;line-height:1.4}
    .stat p{display:none}
  }
</style>
