---
// Pourquoi les entreprises nous choisissent : bande noire, quatre arguments numérotés.
import { rich, pad } from '../../lib/site';
import type { CollectionEntry } from 'astro:content';
interface Props { pourquoi: CollectionEntry<'accueil'>['data']['pourquoi'] }
const { pourquoi } = Astro.props;
---
<section class="why on-dark" aria-labelledby="why-titre">
  <div class="section-head">
    <h2 id="why-titre" class="h2" set:html={rich(pourquoi.titre)}></h2>
    <p>{pourquoi.texte}</p>
  </div>
  <div class="items">
    {pourquoi.items.map((it, i) => <div class="item"><span class="n">{pad(i + 1)}</span><h3>{it.titre}</h3><p>{it.texte}</p></div>)}
  </div>
</section>
<style>
  .why{background:var(--dark);color:var(--on-dark);padding:clamp(50px, 7vw, 100px) var(--gutter);display:flex;flex-direction:column;gap:clamp(22px, 4.9vw, 70px)}
  h2 :global(.serif){color:var(--accent)}
  .items{display:grid;grid-template-columns:repeat(4, minmax(0, 1fr))}
  .item{display:flex;flex-direction:column;gap:16px;padding:0 30px;border-left:1px solid var(--dark-line)}
  .item:first-child{padding-left:0;border-left:0}
  .item:last-child{padding-right:0}
  .n{font-size:44px;line-height:1;font-weight:600;letter-spacing:-.04em;color:var(--accent)}
  h3{font-size:22px;letter-spacing:-.02em}
  .item p{font-size:15px;line-height:1.65;color:var(--on-dark-muted)}
  @media (max-width:1024px){
    .items{grid-template-columns:repeat(2, minmax(0, 1fr));row-gap:36px}
    .item:nth-child(3){padding-left:0;border-left:0}
  }
  @media (max-width:640px){
    .why{padding:50px 20px 36px}
    .items{grid-template-columns:1fr;row-gap:0}
    .item,.item:nth-child(n){flex-direction:row;flex-wrap:wrap;gap:6px 16px;padding:18px 0;border-left:0;border-top:1px solid var(--dark-line)}
    .n{font-size:26px;width:34px}
    h3{font-size:17px;flex:1}
    .item p{flex-basis:100%;padding-left:50px;font-size:14px;line-height:1.55}
  }
</style>
