---
// En-tête de l'accueil : pastille, promesse, texte, audit en principal, rendez-vous en secondaire.
import Bouton from '../shyft/Bouton.astro';
import Icon from '../shyft/Icon.astro';
import { rich } from '../../lib/site';
import type { CollectionEntry } from 'astro:content';
interface Props { hero: CollectionEntry<'accueil'>['data']['hero']; calUrl: string }
const { hero, calUrl } = Astro.props;
---
<section class="hero" id="top">
  <span class="badge"><b>{hero.badge}</b>{hero.badgeTexte}</span>
  <h1 class="h1"><Fragment set:html={rich(hero.titre)} /><Icon name="trend" size={34} stroke={1.7} class="trend" /></h1>
  <p class="lead">{hero.texte}</p>
  <div class="ctas">
    <Bouton href="/audit-offert" block>{hero.cta}</Bouton>
    <Bouton href={calUrl} variant="outline" emplacement="accueil-en-tete" block>{hero.ctaSecondaire}</Bouton>
  </div>
</section>
<style>
  .hero{padding:70px var(--gutter) 0;display:flex;flex-direction:column;align-items:center;gap:28px;text-align:center}
  .badge{display:inline-flex;align-items:center;gap:10px;padding:8px 16px 8px 10px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-size:13px;font-weight:500;color:var(--muted)}
  .badge b{padding:4px 9px;border-radius:999px;background:var(--ink);color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.04em}
  h1{max-width:1120px}
  h1 :global(.trend){display:none}
  .lead{max-width:610px}
  .ctas{display:flex;align-items:center;gap:14px;padding-top:4px}
  @media (max-width:640px){
    .hero{padding-top:34px;gap:18px}
    .badge{font-size:12px;padding:6px 13px 6px 7px}
    .badge b{font-size:10px;padding:3px 8px}
    h1{font-size:48px;line-height:.95;letter-spacing:-.055em}
    h1 :global(br){display:none}
    h1 :global(.trend){display:inline-block;vertical-align:-4px;margin-left:6px}
    .lead{font-size:15px}
    /* Deux boutons compacts côte à côte. */
    .ctas{width:100%;gap:8px}
    .ctas :global(.btn.btn){flex:1 1 0;min-width:0;min-height:48px;padding:6px 12px;justify-content:center;font-size:14px;white-space:nowrap}
    .ctas :global(.btn-dot){display:none}
  }
</style>
