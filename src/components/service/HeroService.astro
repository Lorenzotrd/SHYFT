---
// En-tête d'une page service : fil d'Ariane, promesse, rendez-vous et audit, carte « ce qu'on suit chaque mois ».
import Bouton from '../shyft/Bouton.astro';
import { rich, pad, liens } from '../../lib/site';
interface Props {
  nom: string; titre: string; texte: string; suivi: string[]; calUrl: string;
  commun: { filAccueil: string; filServices: string; ctaRdv: string; ctaAudit: string; suiviSurtitre: string; suiviTitre: string };
}
const { nom, titre, texte, suivi, calUrl, commun } = Astro.props;
---
<section class="hero">
  <div class="copy">
    <nav class="crumbs" aria-label="Fil d’Ariane">
      <ol><li><a href="/">{commun.filAccueil}</a></li><li><a href="/#services">{commun.filServices}</a></li><li aria-current="page">{nom}</li></ol>
    </nav>
    <h1 class="title" set:html={rich(titre)}></h1>
    <p class="lead" set:html={liens(texte)}></p>
    <div class="ctas">
      <Bouton href={calUrl} emplacement="service-en-tete" block>{commun.ctaRdv}</Bouton>
      <Bouton href="/audit-offert" variant="outline" block>{commun.ctaAudit}</Bouton>
    </div>
  </div>
  <aside class="track on-dark" aria-labelledby="suivi-titre">
    <span class="k">{commun.suiviSurtitre}</span>
    <p id="suivi-titre" class="t" set:html={rich(commun.suiviTitre)}></p>
    <ol>{suivi.map((s, i) => <li><span>{pad(i + 1)}</span>{s}</li>)}</ol>
  </aside>
</section>
<style>
  .hero{padding:60px var(--gutter) 0;display:flex;align-items:center;gap:clamp(32px, 4.9vw, 70px)}
  .copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:26px}
  .crumbs ol{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:10px;font-size:14px;color:var(--muted)}
  .crumbs li+li::before{content:"/";margin-right:10px}
  .crumbs a:hover{color:var(--ink)}
  .crumbs [aria-current]{color:var(--ink);font-weight:600}
  .title{font-size:clamp(40px, 5.6vw, 80px);line-height:.96;letter-spacing:-.05em}
  .lead{max-width:620px}
  .ctas{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding-top:6px}
  .track{flex:0 0 460px;display:flex;flex-direction:column;gap:10px;padding:34px 34px 16px;border-radius:28px;background:var(--dark);color:var(--on-dark)}
  .k{font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--on-dark-muted)}
  .t{margin-bottom:12px;font-size:26px;line-height:1.2;font-weight:600;letter-spacing:-.03em}
  .t :global(.serif){color:var(--accent)}
  .track ol{list-style:none;padding:0}
  .track li{display:flex;align-items:center;gap:18px;padding:18px 0;border-top:1px solid var(--dark-line);font-size:17px;color:var(--on-dark-2)}
  .track li span{width:28px;font-size:15px;font-weight:600;color:var(--accent)}
  @media (max-width:1100px){
    .hero{flex-direction:column;align-items:stretch}
    .track{flex-basis:auto}
  }
  @media (max-width:640px){
    .hero{padding-top:34px}
    .copy{gap:18px}
    .crumbs ol{font-size:13px}
    .title{font-size:44px;letter-spacing:-.055em}
    .lead{font-size:15px}
    /* Deux boutons compacts côte à côte, comme l'accueil. */
    .ctas{flex-wrap:nowrap;gap:8px}
    .ctas :global(.btn.btn){flex:1 1 0;min-width:0;min-height:48px;padding:6px 10px;justify-content:center;font-size:14px;line-height:1.15;text-align:center;white-space:normal}
    .ctas :global(.btn-dot){display:none}
    .track{padding:24px 22px 8px;border-radius:22px}
    .t{font-size:22px}
    .track li{padding:14px 0;font-size:15px;gap:14px}
  }
</style>
