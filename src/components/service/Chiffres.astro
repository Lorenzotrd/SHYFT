---
// Chiffres d'un service : trois cartes (la première en noir), lien vers le rendez-vous ou les résultats, note.
// Les cartes marquées « Exemple fictif » gardent l'étiquette visible et affichent leur durée.
import { rich } from '../../lib/site';
type Carte = { surtitre: string; chiffre: string; unite: string; legende: string; texte: string; exempleFictif: boolean; duree: string };
interface Props { titre: string; lien: string; href: string; cartes: Carte[]; note: string; etiquetteFictif: string; external: boolean }
const { titre, lien, href, cartes, note, etiquetteFictif, external } = Astro.props;
---
<section class="section figures" aria-labelledby="fig-titre">
  <div class="head">
    <h2 id="fig-titre" class="h2 h2-page" set:html={rich(titre)}></h2>
    <a class="link" href={href} data-emplacement={external ? 'service-chiffres' : undefined}>{lien}</a>
  </div>
  <div class="grid">
    {cartes.map((c, i) => (
      <article class:list={['card', { dark: i === 0, 'on-dark': i === 0, case: c.exempleFictif }]}>
        <div class="top"><span class="k">{c.surtitre}</span>{c.exempleFictif && <span class="fictif">{etiquetteFictif}</span>}</div>
        <span class="fig">{c.chiffre}{c.unite && <small>{c.unite}</small>}</span>
        <span class="cap">{c.legende}</span>
        <p>{c.texte}</p>
        {c.duree && <span class="duree">{c.duree}</span>}
      </article>
    ))}
  </div>
  {note && <p class="note">{note}</p>}
</section>
<style>
  .figures{display:flex;flex-direction:column;gap:40px}
  .head{display:flex;align-items:flex-end;justify-content:space-between;gap:clamp(20px, 4vw, 60px);flex-wrap:wrap}
  .head h2{max-width:780px}
  .link{font-size:15px;font-weight:600;border-bottom:2px solid var(--ink);padding-bottom:5px}
  .grid{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:16px}
  .card{display:flex;flex-direction:column;padding:34px 34px 32px;border-radius:var(--r-card);background:var(--card)}
  .dark{background:var(--dark);color:var(--on-dark)}
  .top{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .k{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .dark .k{color:var(--on-dark-muted)}
  .fictif{flex:none;padding:5px 10px;border-radius:999px;background:var(--chip);color:var(--muted);font-size:11px;font-weight:600}
  .dark .fictif{background:var(--dark-2);color:var(--on-dark-muted)}
  .fig{margin-top:44px;display:flex;align-items:baseline;gap:8px;white-space:nowrap;font-size:clamp(60px, 6.1vw, 88px);line-height:1;font-weight:600;letter-spacing:-.06em}
  .dark .fig{color:var(--accent)}
  .case .fig{font-size:clamp(56px, 5.3vw, 76px);line-height:.9}
  .fig small{font-size:30px;letter-spacing:-.02em}
  .cap{margin-top:18px;min-height:52px;font-size:20px;line-height:1.3;font-weight:600;letter-spacing:-.02em}
  .case .cap{min-height:0;font-size:18px}
  .card p{margin-top:22px;padding-top:18px;border-top:1px solid var(--line-2);font-size:15px;line-height:1.6;color:var(--muted)}
  .dark p{border-color:var(--dark-line);color:var(--on-dark-muted)}
  .duree{margin-top:14px;font-size:13px;font-weight:600;color:var(--muted)}
  .dark .duree{color:var(--on-dark-muted)}
  .note{font-size:13px;color:var(--label)}
  @media (max-width:1024px){ .grid{grid-template-columns:1fr} .cap{min-height:0} }
  @media (max-width:640px){
    .figures{gap:22px}
    .grid{gap:10px}
    .card{padding:24px;border-radius:20px}
    .fig{margin-top:24px;font-size:60px}
    .cap{margin-top:10px;font-size:17px}
    .card p{margin-top:14px;padding-top:14px;font-size:14px}
  }
</style>
