---
// « Ce qu'on met en place » : bande noire, six éléments numérotés sur trois colonnes.
import { rich, pad } from '../../lib/site';
interface Props { titre: string; texte: string; items: { titre: string; texte: string }[] }
const { titre, texte, items } = Astro.props;
---
<section class="setup on-dark" aria-labelledby="mep-titre">
  <div class="section-head">
    <h2 id="mep-titre" class="h2 h2-page" set:html={rich(titre)}></h2>
    <p>{texte}</p>
  </div>
  <div class="grid">
    {items.map((it, i) => <div class="item"><span class="n">{pad(i + 1)}</span><h3>{it.titre}</h3><p>{it.texte}</p></div>)}
  </div>
</section>
<style>
  .setup{margin-top:var(--section);padding:clamp(50px, 7vw, 100px) var(--gutter);background:var(--dark);color:var(--on-dark);display:flex;flex-direction:column;gap:50px}
  h2 :global(.serif){color:var(--accent)}
  .grid{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));column-gap:40px}
  .item{display:flex;flex-direction:column;gap:12px;padding:30px 30px 30px 0;border-top:1px solid var(--dark-line)}
  .n{font-size:34px;line-height:1;font-weight:600;letter-spacing:-.04em;color:var(--accent)}
  h3{font-size:22px;letter-spacing:-.02em}
  .item p{font-size:15px;line-height:1.6;color:var(--on-dark-muted)}
  @media (max-width:900px){ .grid{grid-template-columns:repeat(2, minmax(0, 1fr))} }
  @media (max-width:640px){
    .setup{padding:50px 20px 30px;gap:24px}
    .grid{grid-template-columns:1fr}
    .item{flex-direction:row;flex-wrap:wrap;gap:6px 16px;padding:18px 0}
    .n{font-size:26px;width:34px}
    h3{flex:1;font-size:17px}
    .item p{flex-basis:100%;padding-left:50px;font-size:14px}
  }
</style>
