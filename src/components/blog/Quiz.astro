---
// Quiz d'auto-diagnostic : une question à la fois (Oui / En partie / Non), puis un score, un verdict et la liste
// des actions à faire pour chaque réponse qui n'est pas « Oui ». Se termine sur l'audit offert et l'appel.
// Sans JavaScript, les questions restent lisibles en liste.
import Bouton from '../shyft/Bouton.astro';
import { route } from '../../lib/i18n';
interface Question { question: string; conseil: string }
interface Verdict { min: number; titre: string; texte: string }
interface Props { id: string; titre: string; intro: string; questions: Question[]; verdicts: Verdict[] }
const { id, titre, intro, questions, verdicts } = Astro.props;
const max = questions.length * 2;
const r = route.fr;
const reponses = [{ label: 'Oui', points: 2 }, { label: 'En partie', points: 1 }, { label: 'Non', points: 0 }];
---
<section class="quiz" data-quiz={id} data-max={max} data-verdicts={JSON.stringify([...verdicts].sort((a, b) => b.min - a.min))} aria-labelledby={`${id}-titre`}>
  <div class="tete">
    <span class="k">Quiz · {questions.length} questions · 1 min</span>
    <p id={`${id}-titre`} class="titre">{titre}</p>
    <p class="intro">{intro}</p>
    <div class="barre" aria-hidden="true"><i></i></div>
  </div>
  <ol class="questions">
    {questions.map((q, i) => (
      <li class="q" data-conseil={q.conseil}>
        <p class="num">Question {i + 1} sur {questions.length}</p>
        <p class="enonce">{q.question}</p>
        <div class="choix">
          {reponses.map((rep) => <button type="button" data-points={rep.points}>{rep.label}</button>)}
        </div>
      </li>
    ))}
  </ol>
  <div class="resultat" hidden aria-live="polite">
    <p class="score"><b data-score></b><span>/{max}</span></p>
    <p class="verdict" data-verdict-titre></p>
    <p class="intro" data-verdict-texte></p>
    <div class="todo" data-todo-bloc>
      <p class="k">Vos priorités</p>
      <ul data-todo></ul>
    </div>
    <div class="actions">
      <Bouton href={r.audit} variant="accent" size="sm" emplacement={`quiz-${id}-audit`}>Recevoir mon audit offert</Bouton>
      <Bouton href={r.rdv} variant="outline-light" size="sm" emplacement={`quiz-${id}-appel`}>Réserver un appel de 30 min</Bouton>
    </div>
    <button type="button" class="refaire" data-refaire>Refaire le quiz</button>
  </div>
</section>
<script>
  type Verdict = { min: number; titre: string; texte: string };
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const items = [...quiz.querySelectorAll<HTMLElement>('.q')];
    const barre = quiz.querySelector<HTMLElement>('.barre i')!;
    const resultat = quiz.querySelector<HTMLElement>('.resultat')!;
    const max = Number(quiz.dataset.max);
    const verdicts: Verdict[] = JSON.parse(quiz.dataset.verdicts || '[]');
    let points: number[] = [];

    const montrer = (i: number) => {
      items.forEach((q, j) => { q.hidden = j !== i; });
      barre.style.width = `${(i / items.length) * 100}%`;
    };
    const terminer = () => {
      items.forEach((q) => { q.hidden = true; });
      barre.style.width = '100%';
      const score = points.reduce((a, b) => a + b, 0);
      const v = verdicts.find((x) => score >= x.min) ?? verdicts[verdicts.length - 1];
      quiz.querySelector('[data-score]')!.textContent = String(score);
      quiz.querySelector('[data-verdict-titre]')!.textContent = v?.titre ?? '';
      quiz.querySelector('[data-verdict-texte]')!.textContent = v?.texte ?? '';
      const todo = quiz.querySelector('[data-todo]')!;
      todo.replaceChildren(...items.filter((_, i) => points[i] < 2).map((q) => {
        const li = document.createElement('li');
        li.textContent = q.dataset.conseil ?? '';
        return li;
      }));
      quiz.querySelector<HTMLElement>('[data-todo-bloc]')!.hidden = !todo.children.length;
      resultat.hidden = false;
      const w = window as unknown as { gtag?: (...a: unknown[]) => void; posthog?: { capture?: (n: string, p: object) => void } };
      const detail = { quiz: quiz.dataset.quiz, score, max, page_origine: location.pathname };
      w.gtag?.('event', 'quiz_termine', detail);
      w.posthog?.capture?.('quiz_termine', detail);
    };

    items.forEach((q, i) => q.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      points = [...points.slice(0, i), Number(b.dataset.points)];
      if (i + 1 < items.length) montrer(i + 1); else terminer();
    })));
    quiz.querySelector('[data-refaire]')!.addEventListener('click', () => { points = []; resultat.hidden = true; montrer(0); });
    quiz.classList.add('pret');
    montrer(0);
  });
</script>
<style>
  .quiz{margin:36px 0;padding:30px;border-radius:var(--r-card);background:var(--dark);color:var(--on-dark)}
  .tete{display:flex;flex-direction:column;gap:8px;margin-bottom:22px}
  .k{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
  .titre{margin:0!important;font-size:28px;line-height:1.1;font-weight:600;letter-spacing:-.035em;color:var(--on-dark)}
  .intro{margin:0!important;font-size:15.5px;line-height:1.55;color:var(--on-dark-muted)}
  .barre{height:6px;margin-top:10px;border-radius:999px;background:var(--dark-line-2);overflow:hidden}
  .barre i{display:block;height:100%;width:0;background:var(--accent);transition:width .3s}
  .questions{list-style:none;margin:0!important;padding:0!important;display:flex;flex-direction:column;gap:18px}
  .num{margin:0 0 4px!important;font-size:13px;color:var(--on-dark-muted)}
  .enonce{margin:0 0 16px!important;font-size:20px;line-height:1.35;font-weight:600;color:var(--on-dark)}
  .choix{display:grid;grid-template-columns:repeat(3, 1fr);gap:8px}
  .choix button{min-height:52px;border:1px solid var(--dark-line-2);border-radius:14px;background:var(--dark-2);color:var(--on-dark);font-size:16px;font-weight:600;cursor:pointer;transition:background .2s, border-color .2s, color .2s}
  .choix button:hover{background:var(--accent);border-color:var(--accent);color:var(--ink)}
  .quiz:not(.pret) .choix{display:none}
  .resultat{display:flex;flex-direction:column;gap:10px}
  .resultat[hidden]{display:none}
  .score{margin:0!important;line-height:1}
  .score b{font-size:64px;font-weight:600;letter-spacing:-.05em;color:var(--accent)}
  .score span{font-size:22px;color:var(--on-dark-muted)}
  .verdict{margin:0!important;font-size:24px;font-weight:600;letter-spacing:-.03em;color:var(--on-dark)}
  .todo{margin-top:8px;padding:18px 20px;border-radius:16px;background:var(--dark-2)}
  .todo[hidden]{display:none}
  .todo ul{margin:8px 0 0!important;padding-left:20px!important;font-size:15.5px;line-height:1.6;color:var(--on-dark-2)}
  .todo li+li{margin-top:6px}
  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
  .actions :global(a){text-decoration:none}
  .refaire{align-self:flex-start;margin-top:4px;padding:0;border:0;background:none;color:var(--on-dark-muted);font-size:14px;text-decoration:underline;cursor:pointer}
  @media (max-width:640px){
    .quiz{padding:22px 18px;border-radius:22px}
    .titre{font-size:23px}
    .enonce{font-size:17px}
    .choix button{font-size:15px;min-height:48px}
    .actions{flex-direction:column}
    .actions :global(.btn){width:100%}
  }
</style>
