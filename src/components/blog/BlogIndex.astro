---
// Liste des articles du blog, en français (/blog) ou en anglais (/en/blog), du plus récent au plus ancien.
import Site from '../../layouts/Site.astro';
import Nav from '../shyft/Nav.astro';
import Footer from '../shyft/Footer.astro';
import Icon from '../shyft/Icon.astro';
import RendezVous from '../shyft/RendezVous.astro';
import { SITE_URL, FOUNDERS, founderName } from '../../lib/site';
import { ORG_ID } from '../../lib/schema';
import { publishedPosts, readingTime } from '../../lib/content';
import { route, ui, type Lang } from '../../lib/i18n';
import { blogUi } from '../../lib/blog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const r = route[lang];
const t = blogUi[lang];
const path = r.blog;
const url = `${SITE_URL}${path}`;
const paths = { fr: route.fr.blog, en: route.en.blog };
const posts = await publishedPosts(lang);
const date = (d: Date) => d.toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
const author = (id: string) => founderName(FOUNDERS.find((f) => f.id === id)!);
const { title, description } = t.index;

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Blog', '@id': `${url}#blog`, url, name: 'Blog SHYFT', description,
    inLanguage: ui[lang].inLanguage, publisher: { '@id': ORG_ID },
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${url}/${p.id}`, datePublished: p.data.pubDate.toISOString() })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: `${SITE_URL}${r.home}` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: url },
    ],
  },
];
---
<Site title={title} description={description} paths={paths} jsonLd={jsonLd}>
  <Nav paths={paths} />
  <main id="main">
    <section class="hero">
      <nav class="crumbs" aria-label={ui[lang].crumbs}>
        <ol><li><a href={r.home}>{t.home}</a></li><li aria-current="page">Blog</li></ol>
      </nav>
      <h1 class="kw">{t.index.h1}</h1>
      <p class="title">{t.index.titre}<em class="serif">{t.index.titreEm}</em>{t.index.titreFin}</p>
      <p class="lead">{t.index.lead}</p>
    </section>

    <section class="section list" aria-label={t.index.articles}>
      {posts.length > 0 ? (
        <div class="grid">
          {posts.map((p) => (
            <article class="post">
              <span class="meta">{date(p.data.pubDate)} · {readingTime(p.body)} min</span>
              <h2><a href={`${r.blog}/${p.id}`}>{p.data.title}</a></h2>
              <p>{p.data.description}</p>
              <span class="by">{author(p.data.author)}<Icon name="arrow" size={12} stroke={2.6} /></span>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty">{t.index.vide} <a class="lien" href={r.audit}>{t.audit}</a></p>
      )}
    </section>
    <RendezVous />
  </main>
  <Footer />
</Site>
<style>
  .hero{padding:60px var(--gutter) 0;display:flex;flex-direction:column;gap:18px;max-width:1100px}
  .crumbs ol{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:10px;font-size:14px;color:var(--muted)}
  .crumbs li+li::before{content:"/";margin-right:10px}
  .crumbs a:hover{color:var(--ink)}
  .crumbs [aria-current]{color:var(--ink);font-weight:600}
  .kw{margin-top:8px;font-size:17px;line-height:1.3;letter-spacing:-.01em;color:var(--ink-2)}
  .title{font-size:clamp(40px, 5.6vw, 80px);line-height:.96;font-weight:600;letter-spacing:-.05em}
  .lead{max-width:680px}
  .grid{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:16px}
  .post{position:relative;display:flex;flex-direction:column;gap:12px;padding:30px;border-radius:var(--r-card);background:var(--card);transition:transform .2s}
  .post:hover{transform:translateY(-2px)}
  .post h2{font-size:24px;line-height:1.15;letter-spacing:-.03em}
  .post h2 a::after{content:"";position:absolute;inset:0;border-radius:inherit}
  .post p{font-size:15px;line-height:1.6;color:var(--muted)}
  .meta,.by{font-size:13px;font-weight:600;color:var(--label)}
  .by{display:inline-flex;align-items:center;gap:8px;margin-top:auto;padding-top:10px}
  .empty{max-width:720px;padding:32px;border-radius:var(--r-card);background:var(--card);font-size:17px;line-height:1.6;color:var(--ink-2)}
  @media (max-width:980px){ .grid{grid-template-columns:repeat(2, minmax(0, 1fr))} }
  @media (max-width:640px){
    .hero{padding-top:34px;gap:12px}
    .kw{font-size:14px}
    .title{font-size:44px;letter-spacing:-.055em}
    .grid{grid-template-columns:1fr}
    .post{padding:22px}
    .empty{padding:22px;font-size:15px}
  }
</style>
