---
// Légende numérotée sous une maquette : chaque numéro renvoie à une pastille jaune posée sur le dessin.
interface Props { reperes: string[] }
const { reperes } = Astro.props;
---
<ol class="reperes">{reperes.map((r, i) => <li><span aria-hidden="true">{i + 1}</span>{r}</li>)}</ol>
<style>
  .reperes{list-style:none;margin:18px 0 0!important;padding:0!important;display:grid;grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));gap:8px 18px;font-size:14.5px;line-height:1.45;color:var(--ink-2)}
  li{display:flex;align-items:flex-start;gap:10px;margin:0!important}
  span{flex:none;display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--accent);color:var(--ink);font-size:12px;font-weight:700}
</style>
