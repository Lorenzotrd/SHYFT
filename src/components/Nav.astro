---
// Barre de navigation : menu des secteurs, méga-menu des expertises par groupe, méthode, appel à l'action.
import { sectors, expertises, single, expertiseUrl, find } from '../lib/content';
import Logo from './Logo.astro';

const [allSectors, allExpertises, nav] = await Promise.all([sectors(), expertises(), single('navigation')]);
---
<nav class="nav" aria-label="Navigation principale"><Logo /><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span>☰</span></button><div class="navigation" id="navigation"><div class="dropdown"><button class="dropdown-toggle" aria-expanded="false" aria-controls="sector-menu">Nos secteurs <span aria-hidden="true">⌄</span></button><div class="dropdown-menu" id="sector-menu" hidden>{allSectors.map((s) => <a href={`/secteurs/${s.id}`}>{s.data.name}<span aria-hidden="true">↗</span></a>)}<a href="/secteurs">Tous les secteurs <span aria-hidden="true">→</span></a></div></div><div class="dropdown mega"><button class="dropdown-toggle" aria-expanded="false" aria-controls="expertise-menu">Nos expertises <span aria-hidden="true">⌄</span></button><div class="dropdown-menu mega-menu" id="expertise-menu" hidden><div class="mega-cols">{nav.groups.map((g) => <div class="mega-col"><span class="mega-label">{g.name}</span>{g.expertises.map((id) => { const e = find(allExpertises, id); return <a href={expertiseUrl(id)}><span class="mega-text"><b>{e.data.menu}</b><i>{e.data.hint}</i></span><span aria-hidden="true">↗</span></a>; })}</div>)}</div><a class="mega-all" href="/expertises">Toutes nos expertises <span aria-hidden="true">→</span></a></div></div><a href="/#methode">Notre méthode</a></div><a class="btn btn-lime nav-cta" href="#contact">Parlons de votre projet <span class="arrow-circle">↗</span></a></nav>
