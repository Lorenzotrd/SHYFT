---
// « Pourquoi SHYFT » : titre centré et bento de quatre tuiles.
import { br } from '../../lib/site';
import type { CollectionEntry } from 'astro:content';
interface Props { why: CollectionEntry<'accueil'>['data']['why'] }
const { why } = Astro.props;
const t = why.tiles;
---
<section class="block">
  <div class="wrap center">
    <div class="kicker">{why.kicker}</div>
    <h2 class="title" set:html={br(why.title)}></h2>
    <p class="sub" set:html={br(why.sub)}></p>
  </div>
  <div class="wrap">
    <div class="bento"><div class="tile skyt"><span class="tile-eyebrow">{t.sky.eyebrow}</span><span class="giant-arrow" aria-hidden="true">↗</span><div class="inner"><div class="big">{t.sky.big}</div><p>{t.sky.text}</p></div></div><div class="tile grey"><span class="tile-eyebrow">{t.grey.eyebrow}</span><div class="stat">{t.grey.stat}<span>{t.grey.statUnit}</span></div><h3 set:html={br(t.grey.title)}></h3><p>{t.grey.text}</p><a class="text-link" href="#methode">{t.grey.link}</a></div><div class="tile limet"><span class="tile-eyebrow">{t.lime.eyebrow}</span><div class="stat">{t.lime.stat}<span>↗</span></div><p>{t.lime.text}</p></div><div class="tile darkt"><span set:html={br(t.dark.text)}></span><span class="ownership-icon" aria-hidden="true">◎</span></div></div>
</div>
</section>
