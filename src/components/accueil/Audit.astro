---
// Audit offert : ce qu'on regarde, et un exemple de synthèse.
import type { CollectionEntry } from 'astro:content';
interface Props { audit: CollectionEntry<'accueil'>['data']['audit'] }
const { audit } = Astro.props;
---
<section class="block" id="audit" style="background:var(--mist)">
  <div class="wrap audit">
    <div>
      <div class="kicker">{audit.kicker}</div>
      <h2 class="title">{audit.title}</h2>
      <ul class="plain">
        {audit.items.map((i) => <li>{i}</li>)}
      </ul>
      <a class="btn btn-lime" href="#contact">{audit.cta}</a>
    </div>
    <div class="report" aria-label="Exemple de synthèse d'audit">
      <div class="report-head"><b>{audit.reportTitle}</b><span>{audit.reportLabel}</span></div>
      {audit.rows.map((r) => <div class="rrow"><div><div class="t">{r.label}</div><div class="d">{r.detail}</div></div><span class={`tag ${r.state}`}>{r.tag}</span></div>)}
    </div>
  </div>
</section>
