---
// En-tête de l'accueil : navigation, promesse, cartes de signaux en arc, nuages, puis le bandeau des secteurs.
import Nav from '../Nav.astro';
interface Props { hero: { eyebrow: string; title: string; title2: string; lead: string; ctaMethod: string; ctaAudit: string; caption: string } }
const { hero } = Astro.props;
---
<div class="hero-shell">
<header class="hero" id="top">
  <Nav />

  <div class="hero-copy"><div class="hero-eyebrow"><span></span> {hero.eyebrow}</div>
    <h1>{hero.title} <br><span class="l2">{hero.title2}</span></h1>
    <p class="lead">{hero.lead}</p>
    <div class="hero-cta">
      <a class="btn btn-glass" href="#methode">{hero.ctaMethod}</a>
      <a class="btn btn-lime" href="#contact">{hero.ctaAudit}
        <span class="dot" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M3 9 L9 3 M4 3 H9 V8" stroke="#D9FF5B" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg></span>
      </a>
    </div>
  </div>

  <div class="arc" aria-label="Exemples de signaux suivis dans un tableau de bord SHYFT">
    <div class="arc-track" id="arcTrack">
      <div class="sig">
        <div class="k">Recherches locales</div>
        <div class="v">Être trouvé, ici.</div>
        <div class="bars" aria-hidden="true"><span style="height:38%"></span><span style="height:52%"></span><span style="height:47%"></span><span style="height:66%"></span><span style="height:74%"></span><span style="height:92%"></span></div>
        <div class="k" style="margin-top:10px">Location matériel, Tours</div>
      </div>
      <div class="sig">
        <div class="k"><span class="pulse"></span>Nouvelle demande</div>
        <div class="v">Nacelle 12 m</div>
        <div class="row"><span>Ville</span><b>Poitiers</b></div>
        <div class="row"><span>Durée</span><b>3 jours</b></div>
        <div class="row"><span>Réponse</span><b>en 2 min</b></div>
      </div>
      <div class="sig lime">
        <div class="k">Candidat franchisé</div>
        <div class="v">Qualifié</div>
        <div class="row" style="border-color:rgba(29,42,6,.15)"><span>Apport</span><b>150 k€</b></div>
        <div class="row" style="border-color:rgba(29,42,6,.15)"><span>Zone</span><b>Lyon</b></div>
        <div class="row" style="border-color:rgba(29,42,6,.15)"><span>Délai</span><b>&lt; 6 mois</b></div>
      </div>
      <div class="sig dark">
        <div class="k">Audit en cours</div>
        <div class="v">Votre entreprise</div>
        <div class="check"><i></i>Référencement</div>
        <div class="check"><i></i>Publicité Google</div>
        <div class="check"><i></i>Publicité Meta</div>
        <div class="check"><i></i>Fiches Google</div>
        <div class="check wait"><i></i>Visibilité IA</div>
      </div>
      <div class="sig glass">
        <div class="k">Fiche Google</div>
        <div class="v">Votre présence locale</div>
        <div class="k" style="margin-top:8px">Horaires · Photos · Avis</div>
        <div class="k" style="margin-top:22px">Le bon contact</div>
        <div class="v">Au bon endroit</div>
      </div>
      <div class="sig">
        <div class="k">Demande de devis</div>
        <div class="v">Extension 30 m²</div>
        <div class="row"><span>Budget</span><b>60 k€</b></div>
        <div class="row"><span>Visite</span><b>jeudi</b></div>
        <div class="row"><span>Source</span><b>Google</b></div>
      </div>
      <div class="sig">
        <div class="k">Coût par demande</div>
        <div class="v">Suivi en direct</div>
        <div class="bars" aria-hidden="true"><span style="height:88%"></span><span style="height:71%"></span><span style="height:64%"></span><span style="height:52%"></span><span style="height:47%"></span><span style="height:41%"></span></div>
      </div>
    </div>
  </div>
  <p class="arc-caption"><span class="caption-dot"></span> {hero.caption}</p>

  <div class="clouds" aria-hidden="true">
    <div class="cloud c4"></div><div class="cloud c5"></div><div class="cloud c1"></div><div class="cloud c2"></div><div class="cloud c3"></div><div class="cloud c6"></div>
  </div>
</header>
</div>

<div class="marquee" aria-label="Secteurs accompagnés">
  <div class="marquee-inner" id="marquee">
    <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 18h13l4-6h-6l-2-5H5z"/><circle cx="7" cy="19" r="2"/><circle cx="16" cy="19" r="2"/></svg>Location de matériel</span>
    <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="9" width="7" height="11"/><rect x="14" y="4" width="7" height="16"/></svg>Réseaux de franchise</span>
    <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11 12 4l9 7v9H3z"/><path d="M9 20v-6h6v6"/></svg>Rénovation et artisans</span>
    <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-5h6v5"/></svg>Immobilier</span>
    <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>Services à domicile</span>
    <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Commerces multi sites</span>
  </div>
</div>
