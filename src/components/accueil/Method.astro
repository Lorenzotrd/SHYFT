---
// Méthode en trois temps et modèle de rémunération.
import { single } from '../../lib/content';
import type { CollectionEntry } from 'astro:content';
interface Props { method: CollectionEntry<'accueil'>['data']['method'] }
const { method } = Astro.props;
const { steps } = await single('methode');
---
<section class="block" id="methode">
  <div class="wrap">
    <div class="kicker">{method.kicker}</div>
    <h2 class="title">{method.title}</h2>
    <div class="steps three">
      {steps.map((s) => <div class="step"><div class="n">{s.label}</div><h3>{s.title}</h3><p>{s.text}</p></div>)}
    </div>

    <div class="pay">
      <div class="big">
        <h3>{method.payTitle}</h3>
        <p>{method.payText}</p>
      </div>
      <div class="side">
        {method.paySide.map((p) => <div><b>{p.title}</b><span>{p.text}</span></div>)}
      </div>
    </div>
  </div>
</section>
