---
// Panneau d'exemples concrets d'un levier : du texte réel, pas une maquette grise.
import type { Sector } from '../../lib/content';
interface Props { kind: 'seo' | 'ads' | 'google' | 'conversion'; sector: Sector }
const { kind, sector } = Astro.props;
const ex = sector.data.examples;
---
{kind === 'seo' && <Fragment><span class="demo-label">Les pages qu’on construit sur votre site</span><ul class="demo-pages">{ex.seoPages.map((u) => <li>{u}</li>)}</ul></Fragment>}
{kind === 'ads' && <Fragment><span class="demo-label">Ce qu’on cible, ce qu’on exclut</span><ul class="demo-kw">{ex.adsKeywords.map((k) => <li><span>{k.keyword}</span><em class={`tag ${k.state}`}>{k.decision}</em></li>)}</ul></Fragment>}
{kind === 'google' && <Fragment><span class="demo-label">Votre fiche, tenue à jour</span><div class="demo-gbp"><b>{ex.google.name}</b><i>{ex.google.rating}</i><i>{ex.google.hours}</i><div class="gbp-actions">{ex.google.actions.map((a) => <span>{a}</span>)}</div></div></Fragment>}
{kind === 'conversion' && <Fragment><span class="demo-label">Ce que le formulaire demande</span><ul class="demo-form">{ex.form.map((q) => <li><span>{q.question}</span><b>{q.answer}</b></li>)}<li class="demo-result"><span>Résultat</span><b>Une demande qualifiée</b></li></ul></Fragment>}
