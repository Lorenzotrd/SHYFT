---
// Les quatre leviers du secteur : chaque carte renvoie vers l'expertise correspondante.
import { br, nn } from '../../lib/site';
import { single, type Sector } from '../../lib/content';
import LeverDemo from './LeverDemo.astro';
interface Props { sector: Sector }
const { sector } = Astro.props;
const s = sector.data;
const { levers } = await single('leviers');
---
<section class="block expertise-section"><div class="wrap"><div class="section-top"><div><div class="kicker">Comment on génère vos opportunités</div><h2 class="title" set:html={br(s.titles.levers)}></h2></div><p class="sub">On relie votre visibilité, les demandes reçues et leur transformation commerciale. Chaque levier répond à une étape précise.</p></div><div class="lever-grid">{levers.map((l, i) => <article class="lever"><span class="lever-n">{nn(i)}</span><h3>{l.name}</h3><h4>{l.subtitle}</h4><p>{s.levers[l.key]}</p><div class="lever-demo"><LeverDemo kind={l.key} sector={sector} /></div><a class="text-link" href={`/expertises/${l.expertise}`}>Voir notre expertise ↗</a></article>)}</div></div></section>
