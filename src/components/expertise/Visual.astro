---
// Une interface différente par expertise, choisie dans le contenu (champ « visual »).
import Serp from './visuals/Serp.astro';
import Ai from './visuals/Ai.astro';
import Ads from './visuals/Ads.astro';
import Creative from './visuals/Creative.astro';
import Workflow from './visuals/Workflow.astro';
import Funnel from './visuals/Funnel.astro';
import Dash from './visuals/Dash.astro';
interface Props { kind: 'serp' | 'ai' | 'ads' | 'creative' | 'workflow' | 'funnel' | 'dash' }
const visuals = { serp: Serp, ai: Ai, ads: Ads, creative: Creative, workflow: Workflow, funnel: Funnel, dash: Dash };
const Component = visuals[Astro.props.kind];
---
<Component />
