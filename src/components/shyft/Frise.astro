---
// Frise d'étapes numérotées : la première en jaune, les suivantes en noir, reliées par un trait.
// Horizontale sur ordinateur, verticale sur téléphone.
import { pad } from '../../lib/site';
interface Props { steps: { titre: string; texte: string }[] }
const { steps } = Astro.props;
---
<ol class="frise" style={`--n:${steps.length}`}>
  {steps.map((s, i) => (
    <li>
      <div class="rail"><span class="num">{pad(i + 1)}</span>{i < steps.length - 1 && <span class="line"></span>}</div>
      <div class="body"><h3>{s.titre}</h3><p>{s.texte}</p></div>
    </li>
  ))}
</ol>
<style>
  .frise{list-style:none;padding:0;display:grid;grid-template-columns:repeat(var(--n), minmax(0, 1fr));gap:28px}
  li{display:flex;flex-direction:column;gap:18px}
  .rail{display:flex;align-items:center;gap:12px}
  .num{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--ink);color:var(--on-dark);font-size:15px;font-weight:700}
  li:first-child .num{background:var(--accent);color:var(--ink)}
  .line{flex:1;height:1px;background:#ccc}
  li:first-child .line{background:var(--ink)}
  .body{display:flex;flex-direction:column;gap:18px}
  h3{font-size:22px;letter-spacing:-.02em}
  p{font-size:15px;line-height:1.6;color:var(--muted)}
  @media (max-width:900px){
    .frise{grid-template-columns:1fr;gap:0}
    li{flex-direction:row;gap:16px}
    .rail{flex-direction:column;gap:6px;align-self:stretch}
    .num{width:36px;height:36px;font-size:13px}
    .line{width:1px;height:auto;flex:1;background:#ccc}
    li:first-child .line{background:#ccc}
    .body{gap:5px;padding:6px 0 22px}
    h3{font-size:17px}
    p{font-size:14px;line-height:1.55}
  }
</style>
