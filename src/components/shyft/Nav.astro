---
// Navigation : grille à trois colonnes (logo, pilule au centre exact, bouton rendez-vous).
// Pilule : Services (menu déroulant en trois colonnes), Méthode, Résultats, Audit. La page en cours est surlignée.
// Téléphone : pilule noire avec bouton jaune ; le menu s'ouvre en dessous, Services devient un accordéon.
import Icon from './Icon.astro';
import Bouton from './Bouton.astro';
import { single, services as allServices } from '../../lib/content';
import { highlight } from '../../lib/site';
interface Props { current?: 'services' | 'audit' }
const { current } = Astro.props;
const [{ nav, calUrl }, services] = await Promise.all([single('site'), allServices()]);
const groupes = ['Acquisition et visibilité', 'Conversion et mesure', 'IA et automatisation'] as const;
const colonnes = groupes
  .map((g) => ({ titre: g, items: services.filter((s) => s.data.groupeMenu === g) }))
  .filter((c) => c.items.length);
---
<header class="nav" data-nav>
  <a class="logo" href="/" aria-label="shyft, accueil">shyft<span>.</span></a>

  <nav class="links" id="menu-principal" aria-label="Navigation principale">
    <div class="drop" data-drop>
      <button type="button" class:list={['drop-btn', { active: current === 'services' }]} aria-expanded="false" aria-controls="menu-services" data-drop-btn>
        {nav.services}<Icon name="chevron" size={12} stroke={2.4} class="chev" />
      </button>
      <div class="panel" id="menu-services" hidden data-drop-panel>
        <div class="cols">
          {colonnes.map((c) => (
            <div class="col">
              <span class="col-title">{c.titre}</span>
              <ul>
                {c.items.map((s) => (
                  <li><a class="entry" href={`/expertises/${s.id}`}><span class="entry-text"><b>{s.data.nom}</b><span>{s.data.phraseMenu}</span></span><Icon name="arrow" size={12} class="entry-arrow" /></a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="cards">
          <a class="card card-audit" href="/audit-offert"><span><b>{nav.menu.auditTitre}</b><span>{nav.menu.auditTexte}</span></span><span class="card-dot"><Icon name="arrow" size={13} /></span></a>
          <a class="card card-rdv" href={calUrl} data-emplacement="menu-services"><span><b>{nav.menu.rdvTitre}</b><span>{nav.menu.rdvTexte}</span></span><span class="card-dot"><Icon name="arrow" size={13} /></span></a>
        </div>
      </div>
    </div>
    <a href="/#methode">{nav.methode}</a>
    <a href="/#resultats">{nav.resultats}</a>
    <a href="/audit-offert" class:list={{ active: current === 'audit' }} aria-current={current === 'audit' ? 'page' : undefined}><span set:html={highlight(nav.audit)} /></a>
    <a class="menu-cta" href={calUrl} data-emplacement="menu-mobile">{nav.cta}</a>
  </nav>

  <div class="end">
    <Bouton href={calUrl} size="sm" emplacement="menu" class="nav-cta">{nav.cta}</Bouton>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Ouvrir le menu" data-menu>
      <Icon name="menu" size={18} stroke={2.2} class="i-open" /><Icon name="close" size={18} stroke={2.2} class="i-close" />
    </button>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const burger = nav?.querySelector<HTMLButtonElement>('[data-menu]');
  const drop = nav?.querySelector<HTMLElement>('[data-drop]');
  const dropBtn = drop?.querySelector<HTMLButtonElement>('[data-drop-btn]');
  const panel = drop?.querySelector<HTMLElement>('[data-drop-panel]');
  const entries = () => [...(panel?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
  const hoverable = window.matchMedia('(hover: hover) and (min-width: 981px)');

  // Menu déroulant Services
  const setDrop = (open: boolean) => {
    if (!panel || !dropBtn) return;
    panel.hidden = !open;
    dropBtn.setAttribute('aria-expanded', String(open));
    drop?.classList.toggle('open', open);
  };
  const isOpen = () => dropBtn?.getAttribute('aria-expanded') === 'true';
  // Ouvert au survol puis cliqué : le clic garde le menu ouvert au lieu de le refermer aussitôt.
  let byHover = false;
  dropBtn?.addEventListener('click', () => { if (byHover && isOpen()) { byHover = false; return; } byHover = false; setDrop(!isOpen()); });
  dropBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setDrop(true); entries()[0]?.focus(); }
  });
  panel?.addEventListener('keydown', (e) => {
    const list = entries();
    const i = list.indexOf(document.activeElement as HTMLAnchorElement);
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); list[(i + 1) % list.length]?.focus(); }
    if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); list[(i - 1 + list.length) % list.length]?.focus(); }
    if (e.key === 'Home') { e.preventDefault(); list[0]?.focus(); }
    if (e.key === 'End') { e.preventDefault(); list[list.length - 1]?.focus(); }
  });
  // Survol sur ordinateur, avec un court délai pour traverser l'espace entre la pilule et le panneau.
  let timer: number | undefined;
  drop?.addEventListener('mouseenter', () => { if (!hoverable.matches) return; clearTimeout(timer); if (!isOpen()) { byHover = true; setDrop(true); } });
  drop?.addEventListener('mouseleave', () => { if (!hoverable.matches) return; timer = window.setTimeout(() => { byHover = false; setDrop(false); }, 180); });
  // Le focus quitte le menu (Tab après la dernière entrée) : on referme.
  drop?.addEventListener('focusout', (e) => { if (hoverable.matches && drop && !drop.contains(e.relatedTarget as Node)) setDrop(false); });

  // Menu téléphone
  const setBurger = (open: boolean) => {
    nav?.classList.toggle('open', open);
    burger?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    if (!open) setDrop(false);
  };
  burger?.addEventListener('click', () => setBurger(!nav?.classList.contains('open')));
  nav?.querySelectorAll('.links a').forEach((a) => a.addEventListener('click', () => { setDrop(false); setBurger(false); }));

  // Échap et clic à l'extérieur ferment tout.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (isOpen()) { setDrop(false); dropBtn?.focus(); }
    else if (nav?.classList.contains('open')) { setBurger(false); burger?.focus(); }
  });
  document.addEventListener('click', (e) => { if (nav && !nav.contains(e.target as Node)) { setDrop(false); setBurger(false); } });
</script>

<style>
  .nav{position:relative;z-index:30;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px;padding:26px 40px}
  .logo{justify-self:start;font-size:26px;font-weight:700;letter-spacing:-.04em;line-height:1}
  .logo span{color:var(--accent)}
  .end{justify-self:end;display:flex;align-items:center;gap:10px}

  /* Pilule */
  .links{display:flex;align-items:center;gap:2px;padding:5px;border-radius:999px;background:var(--ink)}
  .links > a,.drop-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 16px;border:0;border-radius:999px;background:none;font:500 14px/1 var(--sans);color:var(--on-dark-2);cursor:pointer;transition:background .2s,color .2s}
  .links > a:hover,.drop-btn:hover,.links > a.active,.drop-btn.active,.drop.open .drop-btn{background:var(--dark-2);color:var(--on-dark)}
  .links :focus-visible{outline-color:var(--accent)}
  .links :global(.hl){color:var(--accent)}
  .drop-btn :global(.chev){transition:transform .2s}
  .drop.open .drop-btn :global(.chev){transform:rotate(180deg)}
  .links > .menu-cta,.menu-btn{display:none}

  /* Menu déroulant Services : sous le header, centré sur la page */
  .drop{position:static}
  .panel{position:absolute;top:calc(100% - 8px);left:50%;transform:translateX(-50%);width:min(980px, calc(100% - 80px));padding:30px 18px 18px;border-radius:24px;background:var(--card);color:var(--ink);box-shadow:0 40px 80px -30px rgba(0,0,0,.28)}
  .panel::before{content:"";position:absolute;left:0;right:0;top:-24px;height:24px}
  .cols{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:16px;padding:0 16px}
  .col-title{display:block;margin-bottom:8px;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--label)}
  .col ul{list-style:none;padding:0;display:flex;flex-direction:column;gap:2px}
  .entry{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin:0 -12px;padding:11px 12px;border-radius:14px;transition:background .2s}
  .entry:hover,.entry:focus-visible{background:var(--frame)}
  .entry-text{display:flex;flex-direction:column;gap:3px}
  .entry-text b{font-size:16px;font-weight:600;letter-spacing:-.02em}
  .entry-text span{font-size:13.5px;line-height:1.4;color:var(--muted)}
  .entry :global(.entry-arrow){flex:none;margin-top:2px;color:var(--label);transition:transform .2s,color .2s}
  .entry:hover :global(.entry-arrow){color:var(--ink);transform:translate(2px, -2px)}
  .cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;padding-top:16px;border-top:1px solid var(--line-2)}
  .card{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 18px;border-radius:16px;transition:transform .2s}
  .card:hover{transform:translateY(-2px)}
  .card > span:first-child{display:flex;flex-direction:column;gap:2px}
  .card b{font-size:16px;font-weight:600;letter-spacing:-.02em}
  .card > span:first-child > span{font-size:13px}
  .card-dot{flex:none;display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%}
  .card-audit{background:var(--accent);color:var(--ink)}
  .card-audit > span:first-child > span{color:var(--accent-ink)}
  .card-audit .card-dot{background:var(--ink);color:var(--accent)}
  .card-rdv{background:var(--ink);color:var(--on-dark)}
  .card-rdv > span:first-child > span{color:var(--on-dark-muted)}
  .card-rdv .card-dot{background:var(--accent);color:var(--ink)}
  .card-rdv:focus-visible{outline-color:var(--accent)}

  @media (max-width:1100px){
    .nav{padding:22px 24px}
    .links > a,.drop-btn{padding:10px 12px}
    .panel{width:calc(100% - 48px)}
  }

  /* Tablette et téléphone : pilule noire, menu en dessous, Services en accordéon */
  @media (max-width:980px){
    .nav{grid-template-columns:1fr auto;margin:14px 14px 0;padding:7px 7px 7px 20px;border-radius:999px;background:var(--ink)}
    .logo{font-size:19px;color:var(--on-dark)}
    :global(.nav-cta){display:none!important}
    .menu-btn{display:inline-grid;place-items:center;width:44px;height:44px;border:0;border-radius:999px;background:var(--accent);color:var(--ink);cursor:pointer}
    .menu-btn :global(.i-close){display:none}
    .nav.open{border-radius:26px;padding-bottom:14px}
    .nav.open .menu-btn :global(.i-open){display:none}
    .nav.open .menu-btn :global(.i-close){display:block}
    .links{display:none;grid-column:1 / -1;grid-row:2;flex-direction:column;align-items:stretch;gap:2px;margin-top:8px;padding:0 6px 0 0;background:none}
    .nav.open .links{display:flex}
    .links > a,.drop-btn{width:100%;justify-content:space-between;padding:14px 4px;border-radius:12px;font-size:20px;color:var(--on-dark)}
    .links > a:hover,.drop-btn:hover,.links > a.active,.drop-btn.active,.drop.open .drop-btn{background:none;color:var(--accent)}
    .panel{position:static;transform:none;width:auto;padding:0 0 8px 4px;border-radius:0;background:none;box-shadow:none;color:var(--on-dark)}
    .panel::before{display:none}
    .cols{grid-template-columns:1fr;gap:0;padding:0}
    .col-title,.entry-text span,.cards{display:none}
    .col ul{gap:0}
    .entry{margin:0;padding:10px 12px;border-radius:10px}
    .entry:hover,.entry:focus-visible{background:var(--dark-2)}
    .entry-text b{font-size:17px;font-weight:500}
    .entry :global(.entry-arrow){color:var(--on-dark-muted)}
    .links > .menu-cta{display:flex;justify-content:center;margin-top:10px;padding:16px;border-radius:999px;background:var(--accent);color:var(--ink);font-weight:600;font-size:17px}
    .links > .menu-cta:hover{background:#ffd666;color:var(--ink)}
  }
</style>
