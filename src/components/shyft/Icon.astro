---
// Pictogrammes des maquettes, en trait. La couleur suit currentColor.
interface Props { name: 'arrow' | 'check' | 'plus' | 'menu' | 'close' | 'trend' | 'repere' | 'cible' | 'megaphone' | 'robot' | 'site' | 'graphique'; size?: number; stroke?: number; class?: string }
const { name, size = 16, stroke = 2.4, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: '<line x1="6" y1="18" x2="18" y2="6"/><polyline points="9 6 18 6 18 15"/>',
  check: '<polyline points="5 12.5 10 17 19 7"/>',
  plus: '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>',
  menu: '<line x1="5" y1="9" x2="19" y2="9"/><line x1="5" y1="15" x2="19" y2="15"/>',
  close: '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>',
  trend: '<polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/>',
  repere: '<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  cible: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.4"/><circle cx="12" cy="12" r="0.9" fill="currentColor"/>',
  megaphone: '<path d="M4 9h4l7-4v14l-7-4H4z"/><path d="M18 9.5a3.5 3.5 0 0 1 0 5"/>',
  robot: '<rect x="4" y="8" width="16" height="12" rx="3"/><line x1="12" y1="3" x2="12" y2="8"/><circle cx="9.2" cy="13.6" r="1.1" fill="currentColor"/><circle cx="14.8" cy="13.6" r="1.1" fill="currentColor"/>',
  site: '<rect x="3" y="4" width="18" height="15" rx="2.5"/><line x1="3" y1="9" x2="21" y2="9"/><circle cx="6.5" cy="6.5" r="0.8" fill="currentColor"/>',
  graphique: '<line x1="4" y1="20" x2="20" y2="20"/><rect x="6" y="11" width="3.4" height="9"/><rect x="11.5" y="7" width="3.4" height="13"/><rect x="17" y="13" width="3.4" height="7"/>',
};
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]}></svg>
