---
// Page de demande d'audit offert : promesse, ce que vous recevez, puis la demande en deux étapes.
import Site from '../layouts/Site.astro';
import Nav from '../components/shyft/Nav.astro';
import Footer from '../components/shyft/Footer.astro';
import Icon from '../components/shyft/Icon.astro';
import DemandeAudit from '../components/audit/DemandeAudit.astro';
import { SITE_URL, rich, pad } from '../lib/site';
import { single } from '../lib/content';
const [page, commun] = await Promise.all([single('auditOffert'), single('serviceCommun')]);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: page.seoTitle, description: page.seoDescription, url: `${SITE_URL}/audit-offert`, isPartOf: { '@type': 'WebSite', name: 'shyft', url: `${SITE_URL}/` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: commun.filAccueil, item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: page.fil, item: `${SITE_URL}/audit-offert` },
  ] },
];
---
<Site title={page.seoTitle} description={page.seoDescription} path="audit-offert" jsonLd={jsonLd}>
  <Nav />
  <main id="main">
    <section class="hero">
      <div class="copy">
        <nav class="crumbs" aria-label="Fil d’Ariane"><ol><li><a href="/">{commun.filAccueil}</a></li><li aria-current="page">{page.fil}</li></ol></nav>
        <h1 class="title" set:html={rich(page.titre)}></h1>
        <p class="lead">{page.texte}</p>
        <ul class="checks">{page.garanties.map((g) => <li><Icon name="check" size={16} />{g}</li>)}</ul>
      </div>
      <aside class="receive on-dark" aria-labelledby="recevez">
        <span id="recevez" class="k">{page.recevez.surtitre}</span>
        <ol>{page.recevez.points.map((p, i) => <li><span>{pad(i + 1)}</span>{p}</li>)}</ol>
      </aside>
    </section>
    <DemandeAudit />
  </main>
  <Footer />
</Site>
<style>
  .hero{padding:60px var(--gutter) 0;display:flex;align-items:center;gap:clamp(32px, 4.9vw, 70px)}
  .copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:24px}
  .crumbs ol{list-style:none;padding:0;display:flex;gap:10px;font-size:14px;color:var(--muted)}
  .crumbs li+li::before{content:"/";margin-right:10px}
  .crumbs [aria-current]{color:var(--ink);font-weight:600}
  .title{font-size:clamp(44px, 5.8vw, 84px);line-height:.95;letter-spacing:-.05em}
  .lead{max-width:600px}
  .checks{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:12px 26px;font-size:14px;color:var(--ink-2)}
  .checks li{display:inline-flex;align-items:center;gap:8px}
  .receive{flex:0 0 440px;display:flex;flex-direction:column;gap:8px;padding:32px 32px 14px;border-radius:28px;background:var(--dark);color:var(--on-dark)}
  .k{font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--on-dark-muted)}
  .receive ol{list-style:none;padding:0;margin-top:10px}
  .receive li{display:flex;align-items:center;gap:16px;padding:16px 0;border-top:1px solid var(--dark-line);font-size:16px;color:var(--on-dark-2)}
  .receive li span{width:26px;font-size:15px;font-weight:600;color:var(--accent)}
  @media (max-width:1024px){ .hero{flex-direction:column;align-items:stretch} .receive{flex-basis:auto} }
  @media (max-width:640px){ .hero{padding-top:34px} .copy{gap:18px} .title{font-size:44px} .lead{font-size:15px} .receive{padding:24px 22px 8px;border-radius:22px} .receive li{font-size:15px;padding:14px 0} }
</style>
