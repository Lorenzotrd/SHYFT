---
// Pages services en français : /expertises/<fichier>. Gabarit partagé : src/views/Service.astro.
import View from '../../views/Service.astro';
import { services, type Service } from '../../lib/content';

export async function getStaticPaths() {
  return (await services('fr')).map((service) => ({ params: { slug: service.id }, props: { service } }));
}
const { service } = Astro.props as { service: Service };
---
<View service={service} />
