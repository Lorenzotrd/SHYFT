---
// Accueil : promesse, secteurs, expertises, audit offert, mesure, méthode, questions, formulaire.
import Base from '../layouts/Base.astro';
import Hero from '../components/accueil/Hero.astro';
import Why from '../components/accueil/Why.astro';
import Audit from '../components/accueil/Audit.astro';
import Measure from '../components/accueil/Measure.astro';
import Method from '../components/accueil/Method.astro';
import SectorGrid from '../components/SectorGrid.astro';
import ExpertiseCards from '../components/ExpertiseCards.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import Footer from '../components/Footer.astro';
import { BRAND, SITE_URL, br } from '../lib/site';
import { single, expertises } from '../lib/content';

const [home, allExpertises] = await Promise.all([single('accueil'), expertises()]);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'ProfessionalService', name: BRAND, '@id': `${SITE_URL}/#organisation`,
    description: 'Agence d’acquisition digitale pour les PME et réseaux bien implantés sur le terrain : référencement, Google Ads, Meta Ads, intelligence artificielle et mesure.',
    areaServed: { '@type': 'Country', name: 'France' },
    knowsAbout: ['Référencement naturel', 'Référencement local', 'Google Ads', 'Meta Ads', 'Automatisation et intelligence artificielle', 'Optimisation de la conversion', 'Mesure et attribution'],
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Nos expertises', itemListElement: allExpertises.map((e) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: e.data.name, url: `${SITE_URL}/expertises/${e.id}` } })) },
    url: `${SITE_URL}/`, logo: `${SITE_URL}/assets/og.png` },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND, inLanguage: 'fr-FR', url: `${SITE_URL}/` },
];
---
<Base title={home.seoTitle} description={home.seoDescription} path="" jsonLd={jsonLd}>
<Hero hero={home.hero} />
<main id="main">
<Why why={home.why} />
<section class="block" id="secteurs"><div class="wrap"><div class="section-top"><div><div class="kicker">{home.sectors.kicker}</div><h2 class="title" set:html={br(home.sectors.title)}></h2></div><p class="sub" set:html={br(home.sectors.sub)}></p></div><SectorGrid /><div class="sector-tail"><span>{home.sectors.tail}</span><a class="text-link" href="#contact">{home.sectors.tailLink}</a></div></div></section>
<section class="block expertise-section" id="expertises"><div class="wrap"><div class="section-top"><div><div class="kicker">{home.expertises.kicker}</div><h2 class="title" set:html={br(home.expertises.title)}></h2></div><p class="sub" set:html={br(home.expertises.sub)}></p></div><ExpertiseCards /><div class="sector-tail"><span>{home.expertises.tail}</span><a class="text-link" href="/expertises">{home.expertises.tailLink}</a></div></div></section>
<Audit audit={home.audit} />
<Measure measure={home.measure} />
<Method method={home.method} />
<section class="block" id="faq">
  <div class="wrap">
    <div class="kicker">{home.faq.kicker}</div>
    <h2 class="title">{home.faq.title}</h2>
    <Faq items={home.faq.items} />
  </div>
</section>
</main>
<LeadForm />
<Footer />
</Base>
