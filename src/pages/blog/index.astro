---
// Blog (/blog, français) : liste des articles publiés, du plus récent au plus ancien.
import Site from '../../layouts/Site.astro';
import Nav from '../../components/shyft/Nav.astro';
import Footer from '../../components/shyft/Footer.astro';
import Icon from '../../components/shyft/Icon.astro';
import RendezVous from '../../components/shyft/RendezVous.astro';
import { SITE_URL, FOUNDERS, founderName } from '../../lib/site';
import { ORG_ID } from '../../lib/schema';
import { publishedPosts, readingTime } from '../../lib/content';
import { route, ui } from '../../lib/i18n';

const r = route.fr;
const path = '/blog';
const url = `${SITE_URL}${path}`;
const posts = await publishedPosts();
const date = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const author = (id: string) => founderName(FOUNDERS.find((f) => f.id === id)!);
const title = 'Blog SHYFT | Acquisition, SEO et Google Ads pour PME';
const description = 'Conseils concrets pour les PME et négoces BTP : SEO local, Google Ads, Meta Ads, sites qui convertissent, tracking des conversions et automatisation IA.';

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Blog', '@id': `${url}#blog`, url, name: 'Blog SHYFT', description,
    inLanguage: ui.fr.inLanguage, publisher: { '@id': ORG_ID },
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE_URL}/blog/${p.id}`, datePublished: p.data.pubDate.toISOString() })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}${r.home}` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: url },
    ],
  },
];
---
<Site title={title} description={description} paths={{ fr: path }} jsonLd={jsonLd}>
  <Nav paths={{ fr: path }} />
  <main id="main">
    <section class="hero">
      <nav class="crumbs" aria-label={ui.fr.crumbs}>
        <ol><li><a href={r.home}>Accueil</a></li><li aria-current="page">Blog</li></ol>
      </nav>
      <h1 class="kw">Blog acquisition et marketing digital pour PME</h1>
      <p class="title">Ce qui fait <em class="serif">vraiment</em> venir des clients</p>
      <p class="lead">SEO local, Google Ads, Meta Ads, sites, tracking et IA : des réponses concrètes aux questions que se posent les dirigeants de PME.</p>
    </section>

    <section class="section list" aria-label="Articles">
      {posts.length > 0 ? (
        <div class="grid">
          {posts.map((p) => (
            <article class="post">
              <span class="meta">{date(p.data.pubDate)} · {readingTime(p.body)} min</span>
              <h2><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
              <p>{p.data.description}</p>
              <span class="by">{author(p.data.author)}<Icon name="arrow" size={12} stroke={2.6} /></span>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty">Les premiers articles arrivent bientôt. En attendant, <a class="lien" href={r.audit}>demandez l'audit offert de votre visibilité</a> ou découvrez <a class="lien" href={r.anchor('services')}>nos services pour les PME</a>.</p>
      )}
    </section>
    <RendezVous />
  </main>
  <Footer />
</Site>
<style>
  .hero{padding:60px var(--gutter) 0;display:flex;flex-direction:column;gap:18px;max-width:1100px}
  .crumbs ol{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:10px;font-size:14px;color:var(--muted)}
  .crumbs li+li::before{content:"/";margin-right:10px}
  .crumbs a:hover{color:var(--ink)}
  .crumbs [aria-current]{color:var(--ink);font-weight:600}
  .kw{margin-top:8px;font-size:17px;line-height:1.3;letter-spacing:-.01em;color:var(--ink-2)}
  .title{font-size:clamp(40px, 5.6vw, 80px);line-height:.96;font-weight:600;letter-spacing:-.05em}
  .lead{max-width:680px}
  .grid{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:16px}
  .post{position:relative;display:flex;flex-direction:column;gap:12px;padding:30px;border-radius:var(--r-card);background:var(--card);transition:transform .2s}
  .post:hover{transform:translateY(-2px)}
  .post h2{font-size:24px;line-height:1.15;letter-spacing:-.03em}
  .post h2 a::after{content:"";position:absolute;inset:0;border-radius:inherit}
  .post p{font-size:15px;line-height:1.6;color:var(--muted)}
  .meta,.by{font-size:13px;font-weight:600;color:var(--label)}
  .by{display:inline-flex;align-items:center;gap:8px;margin-top:auto;padding-top:10px}
  .empty{max-width:720px;padding:32px;border-radius:var(--r-card);background:var(--card);font-size:17px;line-height:1.6;color:var(--ink-2)}
  @media (max-width:980px){ .grid{grid-template-columns:repeat(2, minmax(0, 1fr))} }
  @media (max-width:640px){
    .hero{padding-top:34px;gap:12px}
    .kw{font-size:14px}
    .title{font-size:44px;letter-spacing:-.055em}
    .grid{grid-template-columns:1fr}
    .post{padding:22px}
    .empty{padding:22px;font-size:15px}
  }
</style>
