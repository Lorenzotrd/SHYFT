---
// Article du blog (/blog/<fichier>) : auteur, date, temps de lecture, contenu Markdown, services liés,
// questions fréquentes, audit offert. JSON-LD BlogPosting, FAQPage et fil d'Ariane. Les brouillons ne sont jamais générés.
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Nav from '../../components/shyft/Nav.astro';
import Footer from '../../components/shyft/Footer.astro';
import Bouton from '../../components/shyft/Bouton.astro';
import Icon from '../../components/shyft/Icon.astro';
import Faq from '../../components/shyft/Faq.astro';
import { SITE_URL, FOUNDERS, founderName } from '../../lib/site';
import { ORG_ID, personId } from '../../lib/schema';
import { publishedPosts, readingTime, services as allServices, type Post } from '../../lib/content';
import { route, ui } from '../../lib/i18n';

export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const d = post.data;
const r = route.fr;
const path = `/blog/${post.id}`;
const url = `${SITE_URL}${path}`;
const auteur = FOUNDERS.find((f) => f.id === d.author)!;
const minutes = readingTime(post.body);
const date = (x: Date) => x.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const { Content } = await render(post);
const lies = (await allServices('fr')).filter((s) => d.services.includes(s.id as never));

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': `${url}#article`, mainEntityOfPage: url, url,
    headline: d.title, description: d.description, inLanguage: ui.fr.inLanguage,
    datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Person', '@id': personId(auteur), name: founderName(auteur), url: `${SITE_URL}/a-propos#${auteur.id}` },
    publisher: { '@id': ORG_ID }, image: `${SITE_URL}/assets/og.png?v=2`, timeRequired: `PT${minutes}M`,
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}${r.home}` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
  ...(d.faq.length ? [{
    '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `${url}#faq`,
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  }] : []),
];
---
<Site title={`${d.title} | SHYFT`} description={d.description} paths={{ fr: path }} jsonLd={jsonLd}>
  <Nav paths={{ fr: path }} />
  <main id="main">
    <article class="article">
      <header class="head">
        <nav class="crumbs" aria-label={ui.fr.crumbs}>
          <ol><li><a href={r.home}>Accueil</a></li><li><a href="/blog">Blog</a></li><li aria-current="page">{d.title}</li></ol>
        </nav>
        <h1 class="title">{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="meta">
          Par <a href={`/a-propos#${auteur.id}`}>{founderName(auteur)}</a>
          <span aria-hidden="true">·</span> <time datetime={d.pubDate.toISOString()}>{date(d.pubDate)}</time>
          {d.updatedDate && <><span aria-hidden="true">·</span> mis à jour le <time datetime={d.updatedDate.toISOString()}>{date(d.updatedDate)}</time></>}
          <span aria-hidden="true">·</span> {minutes} min de lecture
        </p>
      </header>
      <div class="prose"><Content /></div>

      {d.faq.length > 0 && (
        <section class="questions" aria-labelledby="faq-titre">
          <h2 id="faq-titre">Questions fréquentes</h2>
          <Faq items={d.faq} />
        </section>
      )}

      {lies.length > 0 && (
        <nav class="related" aria-labelledby="lies-titre">
          <h2 id="lies-titre">Nos services liés à cet article</h2>
          <div>{lies.map((s) => <a href={r.service(s.id)}>{s.data.hero.h1}<span><Icon name="arrow" size={11} /></span></a>)}</div>
        </nav>
      )}

      <aside class="cta on-dark" aria-labelledby="cta-titre">
        <span class="k">Audit offert</span>
        <p id="cta-titre" class="cta-title">Voyez où vous en êtes, <em class="serif">gratuitement</em></p>
        <p>Votre visibilité sur Google et Maps, vos publicités, votre site et votre suivi des demandes, analysés en 24 h. Sans engagement.</p>
        <Bouton href={r.audit}>Recevoir mon audit offert</Bouton>
      </aside>
    </article>
  </main>
  <Footer />
</Site>
<style>
  .article{padding:60px var(--gutter) 0;display:flex;flex-direction:column;gap:44px;max-width:calc(820px + 2 * var(--gutter));margin:0 auto;width:100%}
  .head{display:flex;flex-direction:column;gap:18px}
  .crumbs ol{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:10px;font-size:14px;color:var(--muted)}
  .crumbs li+li::before{content:"/";margin-right:10px}
  .crumbs a:hover{color:var(--ink)}
  .crumbs [aria-current]{color:var(--ink);font-weight:600}
  .title{font-size:clamp(36px, 4.6vw, 60px);line-height:1;letter-spacing:-.045em}
  .meta{display:flex;flex-wrap:wrap;gap:6px 10px;font-size:14px;color:var(--label)}
  .meta a{color:var(--ink);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  .prose{font-size:18px;line-height:1.75;color:var(--ink-2)}
  .prose :global(h2){margin:44px 0 14px;font-size:30px;line-height:1.15;letter-spacing:-.03em;color:var(--ink)}
  .prose :global(h3){margin:30px 0 10px;font-size:22px;letter-spacing:-.02em;color:var(--ink)}
  .prose :global(p),.prose :global(ul),.prose :global(ol){margin:0 0 18px}
  .prose :global(ul),.prose :global(ol){padding-left:22px}
  .prose :global(a){text-decoration:underline;text-underline-offset:.22em}
  .prose :global(img){border-radius:var(--r);margin:10px 0}
  .prose :global(blockquote){margin:0 0 18px;padding:4px 0 4px 20px;border-left:3px solid var(--accent)}
  .prose :global(strong){color:var(--ink)}
  .prose :global(table){width:100%;margin:10px 0 24px;border-collapse:collapse;font-size:16px;line-height:1.5;display:block;overflow-x:auto}
  .prose :global(th),.prose :global(td){padding:12px 14px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
  .prose :global(th){font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--label);white-space:nowrap}
  /* Encadré « l'essentiel » et schémas insérés en HTML dans le Markdown. */
  .prose :global(.essentiel){margin:0 0 28px;padding:24px 28px;border-radius:var(--r);background:var(--card)}
  .prose :global(.essentiel p:first-child){margin-bottom:8px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
  .prose :global(.essentiel ul){margin:0}
  .prose :global(figure){margin:10px 0 28px;padding:24px;border-radius:var(--r);background:var(--card)}
  .prose :global(figcaption){margin-top:16px;font-size:14px;line-height:1.55;color:var(--muted)}
  .prose :global(.geogrid){display:grid;grid-template-columns:repeat(7, 1fr);gap:8px;max-width:420px;margin:0 auto}
  .prose :global(.geogrid span){display:grid;place-items:center;aspect-ratio:1;border-radius:50%;font-size:14px;font-weight:700;color:#fff}
  .prose :global(.geogrid .t){background:var(--map-top)}
  .prose :global(.geogrid .m){background:var(--map-mid)}
  .prose :global(.geogrid .l){background:var(--map-low)}
  .prose :global(.geogrid .c){outline:3px solid var(--ink);outline-offset:2px}
  .prose :global(.legende){display:flex;flex-wrap:wrap;justify-content:center;gap:8px 18px;margin-top:16px;font-size:14px;color:var(--muted)}
  .prose :global(.legende i){display:inline-block;width:12px;height:12px;margin-right:6px;border-radius:50%;vertical-align:-1px}
  .questions{display:flex;flex-direction:column;gap:20px}
  .questions h2{font-size:30px;line-height:1.15;letter-spacing:-.03em}
  .related{display:flex;flex-direction:column;gap:16px;padding-top:30px;border-top:1px solid var(--line)}
  .related h2{font-size:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
  .related div{display:flex;flex-wrap:wrap;gap:10px}
  .related a{display:inline-flex;align-items:center;gap:10px;padding:12px 14px 12px 20px;border-radius:999px;background:var(--card);font-size:15px;font-weight:500;transition:background .2s}
  .related a:hover{background:var(--accent)}
  .related a span{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--chip)}
  .cta{display:flex;flex-direction:column;align-items:flex-start;gap:16px;padding:40px;border-radius:28px;background:var(--dark);color:var(--on-dark)}
  .k{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--on-dark-muted)}
  .cta-title{font-size:34px;line-height:1.05;font-weight:600;letter-spacing:-.04em}
  .cta-title :global(.serif){color:var(--accent)}
  .cta p:not(.cta-title){max-width:560px;font-size:15px;line-height:1.6;color:var(--on-dark-muted)}
  @media (max-width:640px){
    .article{padding-top:34px;gap:28px}
    .prose{font-size:16px}
    .prose :global(h2){font-size:24px}
    .prose :global(.essentiel),.prose :global(figure){padding:20px}
    .prose :global(.geogrid){gap:5px}
    .prose :global(.geogrid span){font-size:12px}
    .questions h2{font-size:24px}
    .cta{padding:26px 22px;border-radius:22px}
    .cta-title{font-size:27px}
  }
</style>
