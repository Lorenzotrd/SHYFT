---
// Article du blog en français (/blog/<fichier>). Le gabarit est commun aux deux langues.
import ArticlePage from '../../components/blog/ArticlePage.astro';
import { publishedPosts, type Post } from '../../lib/content';

export async function getStaticPaths() {
  return (await publishedPosts('fr')).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---
<ArticlePage post={post} lang="fr" />
