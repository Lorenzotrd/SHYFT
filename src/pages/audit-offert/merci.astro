---
// Merci : affichée après une demande d'audit réussie. Page en noindex, hors du sitemap.
// C'est ici que la conversion est comptée, une seule fois, si la visite vient bien d'un envoi du formulaire.
import Site from '../../layouts/Site.astro';
import Nav from '../../components/shyft/Nav.astro';
import Footer from '../../components/shyft/Footer.astro';
import Bouton from '../../components/shyft/Bouton.astro';
import Icon from '../../components/shyft/Icon.astro';
import { rich, pad } from '../../lib/site';
import { single, services as allServices } from '../../lib/content';
const [page, site, services] = await Promise.all([single('merci'), single('site'), allServices()]);
const [avant, apres] = page.email.texte.split('{adresse}');
---
<Site title={page.seoTitle} description={page.seoDescription} path="audit-offert/merci" noindex>
  <Nav current="audit" />
  <main id="main">
    <section class="hero">
      <span class="tick"><Icon name="check" size={38} stroke={2.8} /></span>
      <h1 class="h1" set:html={rich(page.titre)}></h1>
      <p class="lead">{page.texte}</p>
    </section>

    <section class="section grid">
      <div class="next">
        <h2 class="k">{page.suiteTitre}</h2>
        <ol>
          {page.etapes.map((e, i) => (
            <li class={e.etat}>
              <div class="rail">
                <span class="dot">{e.etat === 'fait' ? <Icon name="check" size={20} stroke={3} /> : e.etat === 'a-venir' ? pad(i + 1) : ''}</span>
                {i < page.etapes.length - 1 && <span class="line"></span>}
              </div>
              <div class="step">
                <div><h3>{e.titre}</h3><p>{e.texte}</p></div>
                <span class="status">{e.statut}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="side">
        <div class="wait on-dark">
          <span class="k">{page.attente.surtitre}</span>
          <p class="wait-title" set:html={rich(page.attente.titre)}></p>
          <p>{page.attente.texte}</p>
          <Bouton href={site.calUrl} emplacement="merci" block class="wait-cta">{page.attente.cta}</Bouton>
        </div>
        <div class="mail">
          <span class="mail-ico"><Icon name="mail" size={20} stroke={1.9} /></span>
          <div><h3>{page.email.titre}</h3><p>{avant}<b>{page.email.adresse}</b>{apres}</p></div>
        </div>
      </div>
    </section>

    <nav class="section levers" aria-label={page.leviersTitre}>
      <span class="k">{page.leviersTitre}</span>
      <div>{services.map((s) => <a href={`/expertises/${s.id}`}>{s.data.nom}<span><Icon name="arrow" size={11} /></span></a>)}</div>
    </nav>
  </main>
  <Footer />
</Site>

<script>
  // Conversion : la note laissée par le formulaire est lue puis effacée, pour ne compter qu'une fois.
  // On attend la fin du chargement pour que le script de mesure (et son consentement) soit prêt.
  document.addEventListener('DOMContentLoaded', () => {
    let detail: unknown = null;
    try {
      const raw = sessionStorage.getItem('shyft:audit');
      if (raw) { detail = JSON.parse(raw); sessionStorage.removeItem('shyft:audit'); }
    } catch { /* stockage bloqué ou note illisible : pas de conversion */ }
    if (detail) document.dispatchEvent(new CustomEvent('shyft:lead', { detail }));
  });
</script>

<style>
  .hero{padding:80px var(--gutter) 0;display:flex;flex-direction:column;align-items:center;gap:22px;text-align:center}
  .tick{display:inline-grid;place-items:center;width:84px;height:84px;border-radius:50%;background:var(--accent);box-shadow:0 20px 40px -18px rgba(0,0,0,.35)}
  .hero h1{font-size:clamp(46px, 6.4vw, 92px)}
  .hero .lead{max-width:600px;font-size:clamp(16px, 1.4vw, 20px)}
  .grid{padding-top:70px;display:grid;grid-template-columns:1.35fr 1fr;gap:20px;align-items:start}
  .k{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
  .next{display:flex;flex-direction:column;gap:26px;padding:40px 40px 14px;border-radius:28px;background:var(--card)}
  ol{list-style:none;padding:0}
  li{display:flex;gap:20px}
  .rail{display:flex;flex-direction:column;align-items:center}
  .dot{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#e4e4e4;color:var(--muted);font-size:15px;font-weight:700}
  .fait .dot{background:var(--accent);color:var(--ink)}
  .en-cours .dot{background:none;border:2.5px dashed var(--ink)}
  .line{flex:1;width:2px;margin:6px 0;background:var(--line)}
  .step{flex:1;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:8px 0 30px}
  .step > div{display:flex;flex-direction:column;gap:5px}
  h3{font-size:20px;letter-spacing:-.02em}
  .step p{font-size:15px;line-height:1.55;color:var(--muted)}
  .status{flex:none;padding:6px 12px;border-radius:999px;background:var(--chip);color:var(--muted);font-size:13px;font-weight:600}
  .side{display:flex;flex-direction:column;gap:20px}
  .wait{display:flex;flex-direction:column;gap:16px;padding:36px;border-radius:28px;background:var(--dark);color:var(--on-dark)}
  .wait .k{color:var(--on-dark-muted)}
  .wait-title{font-size:32px;line-height:1.05;font-weight:600;letter-spacing:-.04em}
  .wait-title :global(.serif){color:var(--accent)}
  .wait p:not(.wait-title){font-size:15px;line-height:1.6;color:var(--on-dark-muted)}
  .wait :global(.wait-cta){display:flex;justify-content:space-between;margin-top:8px;padding-left:24px}
  .mail{display:flex;gap:16px;align-items:flex-start;padding:30px 32px;border-radius:28px;background:var(--card)}
  .mail-ico{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;border-radius:14px;background:var(--chip)}
  .mail h3{font-size:17px}
  .mail p{margin-top:6px;font-size:14px;line-height:1.6;color:var(--muted)}
  .mail b{color:var(--ink)}
  .levers{padding-top:80px;display:flex;flex-direction:column;gap:20px}
  .levers div{display:flex;flex-wrap:wrap;gap:10px}
  .levers a{display:inline-flex;align-items:center;gap:10px;padding:12px 14px 12px 20px;border-radius:999px;background:var(--card);font-size:15px;font-weight:500;transition:background .2s}
  .levers a:hover{background:var(--accent)}
  .levers a span{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--chip)}
  @media (max-width:980px){ .grid{grid-template-columns:1fr} }
  @media (max-width:640px){
    .hero{padding-top:44px;gap:16px}
    .tick{width:68px;height:68px}
    .hero h1{font-size:46px}
    .grid{padding-top:40px}
    .next{padding:26px 22px 4px;border-radius:22px}
    li{gap:14px}
    .dot{width:36px;height:36px;font-size:13px}
    .step{flex-direction:column;gap:10px;padding-bottom:22px}
    h3{font-size:17px}
    .step p{font-size:14px}
    .wait{padding:26px 22px;border-radius:22px}
    .wait-title{font-size:26px}
    .mail{padding:22px;border-radius:22px}
    .levers{padding-top:50px}
    .levers a{font-size:14px}
  }
</style>
