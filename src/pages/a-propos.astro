---
// À propos (/a-propos, français seulement) : qui on est, les fondateurs, les chiffres clés et l'approche de l'accueil.
// Noms, photos et LinkedIn des fondateurs : FOUNDERS dans src/lib/site.ts. Textes : src/content/site/a-propos.yaml.
import Site from '../layouts/Site.astro';
import Nav from '../components/shyft/Nav.astro';
import Footer from '../components/shyft/Footer.astro';
import Icon from '../components/shyft/Icon.astro';
import RendezVous from '../components/shyft/RendezVous.astro';
import Pourquoi from '../components/home/Pourquoi.astro';
import Resultats from '../components/home/Resultats.astro';
import { SITE_URL, FOUNDERS, founderName, rich, liens, texteSeul } from '../lib/site';
import { ORG_ID, person } from '../lib/schema';
import { single } from '../lib/content';
import { route, ui } from '../lib/i18n';

const r = route.fr;
const path = '/a-propos';
const url = `${SITE_URL}${path}`;
const [page, home] = await Promise.all([single('aPropos'), single('accueil', 'fr')]);
const fondateurs = page.fondateurs.map((f) => ({ ...f, info: FOUNDERS.find((x) => x.id === f.id)! }));

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'AboutPage', '@id': `${url}#page`, url, name: page.seoTitle,
    description: page.seoDescription, inLanguage: ui.fr.inLanguage,
    about: { '@id': ORG_ID }, mainEntity: { '@id': ORG_ID },
  },
  ...fondateurs.map((f) => ({ '@context': 'https://schema.org', ...person(f.info, 'fr'), jobTitle: f.role, description: texteSeul(f.parcours) })),
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}${r.home}` },
      { '@type': 'ListItem', position: 2, name: 'À propos', item: url },
    ],
  },
];
---
<Site title={page.seoTitle} description={page.seoDescription} paths={{ fr: path }} jsonLd={jsonLd}>
  <Nav current="a-propos" paths={{ fr: path }} />
  <main id="main">
    <section class="hero">
      <nav class="crumbs" aria-label={ui.fr.crumbs}>
        <ol><li><a href={r.home}>Accueil</a></li><li aria-current="page">À propos</li></ol>
      </nav>
      <h1 class="kw">{page.h1}</h1>
      <p class="title" set:html={rich(page.titre)}></p>
      <p class="lead" set:html={liens(page.intro)}></p>
    </section>

    <section class="section who" aria-labelledby="qui-titre">
      <h2 id="qui-titre" class="h2 h2-page" set:html={rich(page.quiTitre)}></h2>
      <div class="who-text">{page.qui.map((p) => <p set:html={liens(p)}></p>)}</div>
    </section>

    <section class="section founders" aria-labelledby="fondateurs-titre">
      <h2 id="fondateurs-titre" class="h2 h2-page" set:html={rich(page.fondateursTitre)}></h2>
      <div class="grid">
        {fondateurs.map((f) => (
          <article class="founder" id={f.id}>
            <img src={f.info.photo} alt={`${founderName(f.info)}, ${f.role.toLowerCase()} de SHYFT`} width="800" height="800" loading="lazy" decoding="async" />
            <div class="founder-text">
              <h3>{founderName(f.info)}</h3>
              <span class="role">{f.role}</span>
              {f.parcours && <p set:html={liens(f.parcours)}></p>}
              {f.info.linkedin && <a class="linkedin" href={f.info.linkedin} rel="noopener me" target="_blank">Profil LinkedIn de {f.info.givenName}<Icon name="arrow" size={12} stroke={2.6} /></a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <Resultats resultats={home.resultats} />
    <div class="why-wrap"><Pourquoi pourquoi={home.pourquoi} /></div>
    <RendezVous />
  </main>
  <Footer />
</Site>
<style>
  .hero{padding:60px var(--gutter) 0;display:flex;flex-direction:column;gap:18px;max-width:1100px}
  .crumbs ol{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:10px;font-size:14px;color:var(--muted)}
  .crumbs li+li::before{content:"/";margin-right:10px}
  .crumbs a:hover{color:var(--ink)}
  .crumbs [aria-current]{color:var(--ink);font-weight:600}
  .kw{margin-top:8px;font-size:17px;line-height:1.3;letter-spacing:-.01em;color:var(--ink-2)}
  .title{font-size:clamp(40px, 5.6vw, 80px);line-height:.96;font-weight:600;letter-spacing:-.05em}
  .lead{max-width:680px}
  .who{display:grid;grid-template-columns:minmax(0, 1fr) minmax(0, 1.4fr);gap:clamp(24px, 5vw, 80px);align-items:start}
  .who-text{display:flex;flex-direction:column;gap:18px;font-size:18px;line-height:1.65;color:var(--ink-2)}
  .founders{display:flex;flex-direction:column;gap:40px}
  .grid{display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:16px}
  .founder{display:flex;gap:28px;align-items:flex-start;padding:28px;border-radius:var(--r-card);background:var(--card);scroll-margin-top:20px}
  .founder img{flex:none;width:160px;height:160px;border-radius:var(--r);object-fit:cover;background:var(--chip)}
  .founder-text{display:flex;flex-direction:column;gap:8px;min-width:0}
  h3{font-size:26px;letter-spacing:-.03em}
  .role{font-size:14px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--label)}
  .founder-text p{margin-top:6px;font-size:15px;line-height:1.6;color:var(--muted)}
  .linkedin{display:inline-flex;align-items:center;gap:8px;margin-top:10px;font-size:15px;font-weight:600;text-decoration:underline;text-underline-offset:4px}
  .why-wrap{margin-top:var(--section)}
  @media (max-width:900px){
    .who{grid-template-columns:1fr}
    .grid{grid-template-columns:1fr}
  }
  @media (max-width:640px){
    .hero{padding-top:34px;gap:12px}
    .crumbs ol{font-size:13px}
    .kw{font-size:14px}
    .title{font-size:44px;letter-spacing:-.055em}
    .who-text{font-size:16px}
    .founders{gap:22px}
    .founder{flex-direction:column;gap:18px;padding:22px}
    .founder img{width:120px;height:120px}
    h3{font-size:22px}
  }
</style>
