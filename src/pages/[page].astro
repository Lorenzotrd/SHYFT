---
// Pages légales en français : /mentions-legales, /confidentialite. Gabarit partagé : src/views/Legal.astro.
import type { CollectionEntry } from 'astro:content';
import View from '../views/Legal.astro';
import { legalPages } from '../lib/content';

export async function getStaticPaths() {
  return (await legalPages('fr')).map((page) => ({ params: { page: page.id }, props: { page } }));
}
const { page } = Astro.props as { page: CollectionEntry<'pages'> };
---
<View page={page} />
