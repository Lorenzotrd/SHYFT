---
// Merci : Cal.com y redirige toute la page après chaque réservation, fenêtre intégrée comprise. Noindex, hors du sitemap.
// Aucun événement GA4 n'est envoyé ici : book_call part du webhook. La page vue sert aux conversions Google Ads,
// comptées une seule fois et seulement si la réservation a été ouverte depuis le site (note laissée par booking.js).
import Site from '../../layouts/Site.astro';
import Nav from '../../components/shyft/Nav.astro';
import Footer from '../../components/shyft/Footer.astro';
import Bouton from '../../components/shyft/Bouton.astro';
import Icon from '../../components/shyft/Icon.astro';
import { rich, pad } from '../../lib/site';
import { single, services as allServices } from '../../lib/content';
const [page, services] = await Promise.all([single('rdvMerci'), allServices()]);
const [avant, apres] = page.email.texte.split('{adresse}');
---
<Site title={page.seoTitle} description={page.seoDescription} path="rendez-vous/merci" noindex>
  <script is:inline>
    // Cal.com peut ajouter nom et email dans l'adresse : on les retire avant tout chargement de la mesure d'audience.
    if (location.search) history.replaceState(null, '', location.pathname + location.hash);
  </script>
  <Nav />
  <main id="main">
    <section class="hero">
      <span class="tick"><Icon name="check" size={38} stroke={2.8} /></span>
      <h1 class="h1" set:html={rich(page.titre)}></h1>
      <p class="lead">{page.texte}</p>
    </section>

    <section class="section grid">
      <div class="call">
        <h2 class="k">{page.appelTitre}</h2>
        <ol>
          {page.points.map((p, i) => (
            <li>
              <span class="num">{pad(i + 1)}</span>
              <div><h3>{p.titre}</h3><p>{p.texte}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="side">
        <div class="audit on-dark">
          <span class="k">{page.audit.surtitre}</span>
          <p class="audit-title" set:html={rich(page.audit.titre)}></p>
          <p>{page.audit.texte}</p>
          <Bouton href="/audit-offert" block class="audit-cta">{page.audit.cta}</Bouton>
        </div>
        <div class="mail">
          <span class="mail-ico"><Icon name="mail" size={20} stroke={1.9} /></span>
          <div><h3>{page.email.titre}</h3><p>{avant}<a href={`mailto:${page.email.adresse}`}><b>{page.email.adresse}</b></a>{apres}</p></div>
        </div>
      </div>
    </section>

    <nav class="section levers" aria-label={page.leviersTitre}>
      <span class="k">{page.leviersTitre}</span>
      <div>{services.map((s) => <a href={`/expertises/${s.id}`}>{s.data.nom}<span><Icon name="arrow" size={11} /></span></a>)}</div>
    </nav>
  </main>
  <Footer />
</Site>

<script>
  // Conversion publicitaire : la note laissée à l'ouverture de la réservation est lue puis effacée.
  // Un rechargement ou une visite directe ne compte donc rien.
  document.addEventListener('DOMContentLoaded', () => {
    let detail: unknown = null;
    try {
      const raw = sessionStorage.getItem('shyft:booking');
      if (raw) { detail = JSON.parse(raw); sessionStorage.removeItem('shyft:booking'); }
    } catch { /* stockage bloqué ou note illisible : pas de conversion */ }
    if (detail) document.dispatchEvent(new CustomEvent('shyft:rdv', { detail }));
  });
</script>

<style>
  .hero{padding:80px var(--gutter) 0;display:flex;flex-direction:column;align-items:center;gap:22px;text-align:center}
  .tick{display:inline-grid;place-items:center;width:84px;height:84px;border-radius:50%;background:var(--accent);box-shadow:0 20px 40px -18px rgba(0,0,0,.35)}
  .hero h1{font-size:clamp(46px, 6.4vw, 92px)}
  .hero .lead{max-width:600px;font-size:clamp(16px, 1.4vw, 20px)}
  .grid{padding-top:70px;display:grid;grid-template-columns:1.35fr 1fr;gap:20px;align-items:start}
  .k{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
  .call{display:flex;flex-direction:column;gap:18px;padding:40px;border-radius:28px;background:var(--card)}
  ol{list-style:none;padding:0}
  li{display:flex;gap:20px;padding:22px 0;border-top:1px solid var(--line)}
  li:first-child{border-top:0;padding-top:8px}
  li:last-child{padding-bottom:0}
  .num{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--accent);color:var(--ink);font-size:15px;font-weight:700}
  li > div{display:flex;flex-direction:column;gap:5px;padding-top:2px}
  h3{font-size:20px;letter-spacing:-.02em}
  li p{font-size:15px;line-height:1.55;color:var(--muted)}
  .side{display:flex;flex-direction:column;gap:20px}
  .audit{display:flex;flex-direction:column;gap:16px;padding:36px;border-radius:28px;background:var(--dark);color:var(--on-dark)}
  .audit .k{color:var(--on-dark-muted)}
  .audit-title{font-size:32px;line-height:1.05;font-weight:600;letter-spacing:-.04em}
  .audit-title :global(.serif){color:var(--accent)}
  .audit p:not(.audit-title){font-size:15px;line-height:1.6;color:var(--on-dark-muted)}
  .audit :global(.audit-cta){display:flex;justify-content:space-between;margin-top:8px;padding-left:24px}
  .mail{display:flex;gap:16px;align-items:flex-start;padding:30px 32px;border-radius:28px;background:var(--card)}
  .mail-ico{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;border-radius:14px;background:var(--chip)}
  .mail h3{font-size:17px}
  .mail p{margin-top:6px;font-size:14px;line-height:1.6;color:var(--muted)}
  .mail b{color:var(--ink)}
  .levers{padding-top:80px;display:flex;flex-direction:column;gap:20px}
  .levers div{display:flex;flex-wrap:wrap;gap:10px}
  .levers a{display:inline-flex;align-items:center;gap:10px;padding:12px 14px 12px 20px;border-radius:999px;background:var(--card);font-size:15px;font-weight:500;transition:background .2s}
  .levers a:hover{background:var(--accent)}
  .levers a span{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--chip)}
  @media (max-width:980px){ .grid{grid-template-columns:1fr} }
  @media (max-width:640px){
    .hero{padding-top:44px;gap:16px}
    .tick{width:68px;height:68px}
    .hero h1{font-size:46px}
    .grid{padding-top:40px}
    .call{padding:26px 22px;border-radius:22px}
    li{gap:14px;padding:18px 0}
    .num{width:36px;height:36px;font-size:13px}
    h3{font-size:17px}
    li p{font-size:14px}
    .audit{padding:26px 22px;border-radius:22px}
    .audit-title{font-size:26px}
    .mail{padding:22px;border-radius:22px}
    .levers{padding-top:50px}
    .levers a{font-size:14px}
  }
</style>
