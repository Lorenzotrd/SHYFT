---
// Prise de rendez-vous (/rendez-vous, /en/book-a-call) : calendrier Cal.com intégré (booking.js), lien de secours
// vers la page Cal.com, téléphone et email. Les boutons du site ouvrent la même réservation en fenêtre.
import Site from '../layouts/Site.astro';
import Nav from '../components/shyft/Nav.astro';
import Footer from '../components/shyft/Footer.astro';
import Icon from '../components/shyft/Icon.astro';
import { SITE_URL, CONTACT, rich } from '../lib/site';
import { single } from '../lib/content';
import { langOf, route, pathsFor, ui } from '../lib/i18n';

const lang = langOf(Astro.url);
const r = route[lang];
const t = ui[lang];
const p = t.rdvPage;
const paths = pathsFor((x) => x.rdv);
const [rdv, site] = await Promise.all([single('rendezVous', lang), single('site', lang)]);
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'en' ? 'Home' : 'Accueil', item: `${SITE_URL}${r.home}` },
    { '@type': 'ListItem', position: 2, name: p.h1, item: `${SITE_URL}${r.rdv}` },
  ],
}];
---
<Site title={p.seoTitle} description={p.seoDescription} paths={paths} jsonLd={jsonLd}>
  <Nav paths={paths} />
  <main id="main">
    <section class="hero">
      <span class="pill"><span class="dot"></span>{rdv.pastille}</span>
      <h1 class="kw">{p.h1}</h1>
      <p class="title" set:html={rich(rdv.titre)}></p>
      <p class="lead">{rdv.texte}</p>
      <ul class="garanties">{rdv.garanties.map((g) => <li><Icon name="check" size={16} />{g}</li>)}</ul>
    </section>
    <section class="section booking" aria-label={p.calendar}>
      <div class="cal" data-cal-inline></div>
      <p class="fallback">
        {p.fallback} <a href={site.calUrl} data-direct data-emplacement="page-rendez-vous-secours" rel="noopener">{p.fallbackLink}</a>
        {CONTACT.phone && <><br>{p.phone} : <a href={`tel:${CONTACT.phone}`} data-emplacement="page-rendez-vous">{CONTACT.phoneDisplay || CONTACT.phone}</a></>}
        <br>{p.email} : <a href={`mailto:${CONTACT.email}`} data-emplacement="page-rendez-vous">{CONTACT.email}</a>
      </p>
    </section>
  </main>
  <Footer />
</Site>
<style>
  .hero{padding:60px var(--gutter) 0;display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center}
  .pill{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;border:1px solid var(--line-3);border-radius:999px;font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}
  .kw{font-size:17px;line-height:1.3;letter-spacing:-.01em;color:var(--ink-2)}
  .title{font-size:clamp(40px, 5.6vw, 80px);line-height:.96;font-weight:600;letter-spacing:-.05em}
  .lead{max-width:620px}
  .garanties{list-style:none;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 26px;font-size:14px;color:var(--ink-2)}
  .garanties li{display:inline-flex;align-items:center;gap:8px}
  .booking{padding-top:clamp(30px, 4vw, 50px);display:flex;flex-direction:column;gap:20px}
  .cal{min-height:640px;padding:10px;border-radius:var(--r-card);background:var(--card);overflow:auto}
  .cal[data-state="failed"]{display:none}
  .fallback{text-align:center;font-size:15px;line-height:1.8;color:var(--muted)}
  .fallback a{color:var(--ink);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  @media (max-width:640px){
    .hero{padding-top:34px;gap:12px}
    .kw{font-size:14px}
    .title{font-size:44px;letter-spacing:-.055em}
    .cal{min-height:560px;padding:0;border-radius:20px}
  }
</style>
