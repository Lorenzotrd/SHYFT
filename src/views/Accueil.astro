---
// Accueil (/ et /en) : en-tête, éventail de cartes, pourquoi nous, six leviers, méthode, résultats,
// audit offert, rendez-vous, questions fréquentes. Tout le texte vient de src/content (Keystatic).
import Site from '../layouts/Site.astro';
import Nav from '../components/shyft/Nav.astro';
import Footer from '../components/shyft/Footer.astro';
import Frise from '../components/shyft/Frise.astro';
import Faq from '../components/shyft/Faq.astro';
import RendezVous from '../components/shyft/RendezVous.astro';
import Bouton from '../components/shyft/Bouton.astro';
import Hero from '../components/home/Hero.astro';
import Eventail from '../components/home/Eventail.astro';
import Pourquoi from '../components/home/Pourquoi.astro';
import Services from '../components/home/Services.astro';
import Resultats from '../components/home/Resultats.astro';
import Audit from '../components/home/Audit.astro';
import { SITE_URL, rich, texteSeul } from '../lib/site';
import { single, services } from '../lib/content';
import { langOf, route, pathsFor, ui } from '../lib/i18n';

const lang = langOf(Astro.url);
const r = route[lang];
const t = ui[lang];
const [home, site, allServices] = await Promise.all([single('accueil', lang), single('site', lang), services(lang)]);
const homeUrl = `${SITE_URL}${r.home}`;

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE_URL}/#organisation`,
    name: 'SHYFT Growth', alternateName: 'SHYFT', url: `${SITE_URL}/`, logo: `${SITE_URL}/assets/icon-512.png`, image: `${SITE_URL}/assets/og.png?v=2`,
    description: texteSeul(home.hero.texte), areaServed: t.areaServed,
    hasOfferCatalog: {
      '@type': 'OfferCatalog', name: 'Services',
      itemListElement: allServices.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.data.nom, description: s.data.carte.texte, url: `${SITE_URL}${r.service(s.id)}`, provider: { '@id': `${SITE_URL}/#organisation` } } })),
    },
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'SHYFT Growth', alternateName: 'SHYFT', inLanguage: t.inLanguage, url: homeUrl },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: home.faq.questions.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
];
---
<Site title={home.seoTitle} description={home.seoDescription} paths={pathsFor((x) => x.home)} jsonLd={jsonLd}>
  <Nav paths={pathsFor((x) => x.home)} />
  <main id="main">
    <Hero hero={home.hero} calUrl={site.calUrl} />
    <Eventail cards={home.eventail} legende={home.hero.legende} />
    <Pourquoi pourquoi={home.pourquoi} />
    <Services intro={home.services} />
    <section class="section methode" id="methode" aria-labelledby="methode-titre">
      <h2 id="methode-titre" class="h2" set:html={rich(home.methode.titre)}></h2>
      <Frise steps={home.methode.etapes} />
    </section>
    <Resultats resultats={home.resultats} />
    <Audit audit={home.audit} />
    <RendezVous />
    <section class="section faq-section" id="faq" aria-labelledby="faq-titre">
      <div class="faq-aside">
        <span class="eyebrow">{home.faq.surtitre}</span>
        <h2 id="faq-titre" class="h2" set:html={rich(home.faq.titre)}></h2>
        <p>{home.faq.texte}</p>
        <Bouton href={site.calUrl} variant="dark" size="sm" emplacement="accueil-faq">{home.faq.cta}</Bouton>
      </div>
      <Faq items={home.faq.questions} />
    </section>
  </main>
  <Footer />
</Site>
<style>
  .methode{display:flex;flex-direction:column;gap:56px}
  .methode h2{max-width:900px}
  .faq-section{display:flex;gap:clamp(24px, 5.5vw, 80px);align-items:flex-start}
  .faq-aside{flex:0 0 380px;display:flex;flex-direction:column;align-items:flex-start;gap:22px}
  .faq-aside p{font-size:16px;line-height:1.6;color:var(--muted)}
  @media (max-width:900px){
    .faq-section{flex-direction:column}
    .faq-aside{flex-basis:auto}
  }
  @media (max-width:640px){
    .methode{gap:24px}
    .faq-section{padding-left:14px;padding-right:14px;gap:18px}
    .faq-aside{padding:0 6px;gap:12px}
    .faq-aside .eyebrow,.faq-aside p,.faq-aside :global(.btn){display:none}
  }
</style>
